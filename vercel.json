{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.belalzaky.uk"
        }
      ],
      "destination": "https://belalzaky.uk/:path*",
      "permanent": true
    },
    { "source": "/mission-control", "destination": "/builds", "permanent": true },
    { "source": "/terms", "destination": "/privacy", "permanent": true }
  ]
}
