---
// A case page, used by all nine /projects/[slug] pages: what happened in one plain
// sentence, the key numbers in a line, the finding and the method, the project's own
// interactive, the full write-up, then the next project.
import Base from './Base.astro';
import type { Stat } from '../data/projects-v2';

interface Props {
  name: string;
  stake: string;
  description: string;
  tools: string;
  year: number;
  github?: string;
  stats?: Stat[];
  finding?: string;
  method?: string;
  next?: { name: string; href: string };
}

const { name, stake, description, tools, year, github, stats = [], finding, method, next } = Astro.props;
const hasChart = Astro.slots.has('chart');
const meta = [
  { k: 'project', v: name.toLowerCase() },
  { k: 'tools', v: tools.toLowerCase() },
  { k: 'year', v: String(year) },
  { k: 'code', v: github ? 'on github' : 'not public', href: github },
  { k: 'all work', v: 'back to work', href: '/projects' },
  { k: 'next', v: next ? next.name.toLowerCase() : 'all projects', href: next ? next.href : '/projects/all' },
];
---

<Base title={`${name} · Belal Zaky`} description={description} ogType="article" current="work" meta={meta}>
  <main class="sheet case">
    <section class="wrap page-head">
      <p class="label"><a href="/projects" class="crumb">work</a> / {name.toLowerCase()} · {year}</p>
      <h1 class="case-h1">{stake}</h1>
      <p class="case-tools">{tools}</p>
      {github && <div class="btn-row case-ctas"><a href={github} class="btn" target="_blank" rel="noopener noreferrer">Code on GitHub ↗</a></div>}
    </section>

    {(finding || method || stats.length > 0) && (
      <section class="wrap" aria-label="Finding and method"><div class="facts">
        {finding && (<div class="fact"><h2 class="label">finding</h2><p class="case-p case-p--strong">{finding}</p></div>)}
        {stats.length > 0 && (
          <div class="fact"><h2 class="label">key numbers</h2>
            <dl class="nums">{stats.map((s) => (<div><dt>{s.label}</dt><dd class:list={{ wrong: s.wrong }}>{s.value}</dd></div>))}</dl>
          </div>
        )}
        {method && (<div class="fact"><h2 class="label">method</h2><p class="case-p case-method">{method}</p></div>)}
      </div></section>
    )}

    {hasChart && (
      <section class="wrap sect" aria-label="Interactive">
        <h2 class="label">interactive</h2>
        <div class="chart"><slot name="chart" /></div>
      </section>
    )}

    <section class="wrap sect" aria-labelledby="writeup-h">
      <h2 id="writeup-h" class="label">the full write-up</h2>
      <div class="prose writeup"><slot /></div>
    </section>

    <section class="wrap sect">
      <nav class="case-nav" aria-label="More projects">
        <a href="/projects" class="btn">← All work</a>
        {next ? <a href={next.href} class="btn">Next: {next.name} →</a> : <a href="/projects/all" class="btn">Everything →</a>}
      </nav>
    </section>
  </main>
</Base>

<style>
  .crumb { text-decoration: underline; text-underline-offset: .2em; }
  .case-h1 { margin-top: 14px; max-width: 30ch; font-size: clamp(26px, 3.2vw, 42px); line-height: 1.12; font-weight: 500; letter-spacing: -.03em; text-wrap: balance; }
  .case-tools { margin-top: 16px; font-family: var(--mono); font-size: 12px; color: var(--mute); }
  .case-ctas { margin-top: 20px; }
  .facts { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 1px; background: var(--gap); border: 1px solid var(--gap); }
  .fact { background: var(--cell); padding: 18px; display: flex; flex-direction: column; gap: 10px; }
  .fact:first-child { grid-column: 1 / -1; }
  .case-p { font-size: 16px; line-height: 1.6; max-width: 70ch; }
  .case-p--strong { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.45; letter-spacing: -.01em; }
  .case-method { font-family: var(--mono); font-size: 12.5px; line-height: 1.7; color: var(--mute); }
  .nums { display: grid; gap: 0; margin: 0; }
  .nums > div { display: flex; justify-content: space-between; gap: 16px; padding: 6px 0; border-top: 1px solid var(--gap); font-size: 14px; }
  .nums > div:first-child { border-top: 0; }
  .nums dt { color: var(--mute); }
  .nums dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 500; }
  .nums dd.wrong { text-decoration: line-through; text-decoration-thickness: 1px; color: var(--mute); }
  .chart { margin-top: 16px; }
  .writeup { margin-top: 16px; max-width: 720px; }
  .writeup :global(h2:first-child) { margin-top: 0; }
  .case-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  @media (max-width: 700px) { .facts { grid-template-columns: 1fr; } }
</style>
