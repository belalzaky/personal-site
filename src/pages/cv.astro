---
import Base from '../layouts/Base.astro';

// Copy from the V2-CV boards (agreed 15 Oct 2026), verbatim. No phone number and no street
// address, on the page or in the PDF. The public PDF (/Belal-Zaky-CV.pdf) is printed from
// this page: the print styles at the foot give A4, light, no nav or footer.

const education = [
  { name: 'King’s College London — MSci (Hons) Pharmacology (integrated master’s, with placement year)', meta: 'Expected 2029', desc: 'London, United Kingdom' },
  { name: 'Emirates International School – Jumeirah — IB Diploma', meta: '2024', desc: 'Dubai, United Arab Emirates' },
];

const projects = [
  { title: 'Causal safety — does an NSAID cause kidney injury?', meta: '2026', stack: 'Python · propensity-score matching · self-controlled case series · bootstrap CI', bullets: [
    'Emulated a new-user, active-comparator study and validated the estimators against a sealed true effect: the crude comparison understated the harm by 46% (OR 1.19), while matching (2.05) and a self-controlled series (2.14) both recovered the truth (2.20).',
    'A simulation study by design — the only setting where you can score a causal method against a known answer. Same protocol queued for real clinical data (MIMIC-IV, credentialing in progress).',
  ] },
  { title: 'PV Intake Assistant — production pharmacovigilance pipeline', meta: '2026', stack: 'Python · scikit-learn · scispaCy · SNOMED CT · pytest · GitHub Actions · Docker', bullets: [
    'Three-stage pipeline: triage a medical abstract for a possible adverse drug event (F1 0.38 → 0.79), extract the drug and effect, then code the effect to SNOMED CT against a 461,000-term vocabulary.',
    'Built as a system, not a notebook — 32 unit tests, CI on every push, a Dockerfile and a CLI. Chose precision over coverage in coding: a wrong code corrupts a safety signal, a blank one does not.',
  ] },
  { title: 'Pharmacovigilance signal detection — FAERS (20M+ FDA reports)', meta: '2026', stack: 'Python · pandas · SQL · openFDA API · PRR / ROR / chi-squared / Evans criteria', bullets: [
    'Built a disproportionality signal-detection pipeline over 20M+ adverse-event reports; validated on the known warfarin–haemorrhage signal (PRR ≈ 5), with negative controls to screen out confounders.',
    'Across companion projects (a live dashboard and a SQL reproduction), showed how notoriety and sampling distort conclusions — a heartburn drug’s 2020–21 report spike was litigation, not clinical harm.',
  ] },
  { title: 'Clinical NLP & EHR modelling — adverse events, risk and survival', meta: '2026', stack: 'R (survival) · Kaplan–Meier · Cox PH · Python · scikit-learn · PubMedBERT', bullets: [
    'Benchmarked four models for detecting adverse drug events in free text: the domain-tuned transformer won, a keyword model beat a general-purpose one, and a zero-shot LLM came last — domain fit beats model size.',
    'Modelled time-to-hypertension in 1,100+ patients: diabetics progressed ~2.4× faster, and a seemingly null age effect proved time-varying.',
  ] },
  { title: 'Mission Control — my own operations app', meta: '2026', stack: 'JavaScript · Electron · Node · Markdown · AI agents', bullets: [
    'A desktop app that runs my projects, study and deadlines from plain-text notes, with an AI assistant whose drafts I approve; 600+ automated tests, each written after a real failure.',
    'Notch, a native macOS (SwiftUI) companion app, puts it in the MacBook notch; I use it every day.',
  ] },
];

const experience = [
  { name: 'King’s Sport, King’s College London — Casual Sports Ground Staff', meta: 'Oct 2026 – Present', desc: 'Front of house at the New Malden ground: opening up, pitch inspections, directing teams, coaches and referees, and the on-site contact with AFC Wimbledon for delays, cancellations and handovers.' },
  { name: 'Aster Pharmacy — Sales Intern', meta: 'Jul 2024', desc: 'Supported customer service and sales operations in a busy retail pharmacy environment, Dubai.' },
  { name: 'Modon Designs — Project Coordinator & Business Development Associate', meta: 'Jun 2022 – Apr 2023', desc: 'Coordinated client–team communication and documentation, built digital filing systems, and supported business development and social media.' },
  { name: 'M2 Supplements — Operations & Marketing Assistant', meta: 'Jan 2022 – Jun 2023', desc: 'Ran order fulfilment, customer communication and social-media campaigns, supporting product launches with the founders.' },
];

const leadership = [
  { name: 'Student Representative — Pharmacology, King’s College London', meta: '2025 – Present', desc: 'Rep in Year 1 (BSc) and again in Year 2 (MSci). Represent coursemates on the Staff–Student Liaison Committee; consolidated scattered module feedback into one case that reached the department and changed the module.' },
  { name: 'Subject Ambassador — Pharmacology, King’s College London', meta: 'Oct 2026 – Present', desc: 'Represent Pharmacology to prospective students and families at open days, applicant days, campus tours and school outreach.' },
  { name: 'King’s100 — Leadership & Employability Programme', meta: 'Oct 2025 – Apr 2026', desc: 'Selected for King’s flagship leadership programme — employer-led challenges.' },
  { name: 'Toastmasters International — Member & Sergeant at Arms', meta: '2023 – Present', desc: 'Regular prepared and impromptu speaking; earned “Speech of the Meeting”.' },
  { name: 'Model United Nations — Delegate', meta: '2023', desc: 'Awarded Delegate of the Conference — research, debate and negotiation.' },
];

const skills = [
  { label: 'Data & technical', value: 'Python (pandas, scikit-learn, matplotlib), R (survival analysis), SQL, machine learning, NLP; Git/GitHub, pytest, GitHub Actions CI, Docker, Astro' },
  { label: 'Methods', value: 'Causal inference (propensity scores, self-controlled case series), survival analysis, disproportionality signal detection, statistical reasoning' },
  { label: 'Domain', value: 'Pharmacovigilance & drug-safety signal detection, real-world evidence, EHR data, SNOMED CT coding' },
  { label: 'Certifications', value: 'Introduction to First Aid in Sport and Physical Activity (UK Coaching, 2026)' },
  { label: 'Communication', value: 'Scientific & report writing, data storytelling, public speaking. English (fluent), Arabic (native)' },
];

const entrySections = [
  { title: 'Experience', items: experience },
  { title: 'Leadership & communication', items: leadership },
];
---

<Base
  title="CV — Belal Zaky"
  description="MSci Pharmacology, King's College London · London | Dubai. Education, selected projects, experience, leadership and skills."
>
  <section class="wrap page-head cv-head">
    <p class="label">Curriculum vitae</p>
    <h1 class="page-h1">Belal Zaky</h1>
    <p class="lead page-lead cv-sub">MSci Pharmacology, King’s College London · London | Dubai</p>
    <p class="cv-print-contact">hello@belalzaky.uk · belalzaky.uk · linkedin.com/in/belalzaky · github.com/belalzaky</p>
    <div class="btn-row cv-actions">
      <a href="/Belal-Zaky-CV.pdf" class="btn btn-primary">Download PDF</a>
      <a href="mailto:hello@belalzaky.uk" class="btn btn-outline cv-mail">hello@belalzaky.uk</a>
    </div>
  </section>

  <section class="wrap sect cv-sect" aria-labelledby="edu-h">
    <h2 id="edu-h" class="label">Education</h2>
    <div class="rows cv-rows">
      {education.map((e) => (
        <div class="row">
          <span class="row-key">{e.meta}</span>
          <div><span class="row-title">{e.name}</span><p class="row-desc">{e.desc}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap sect cv-sect" aria-labelledby="proj-h">
    <h2 id="proj-h" class="label">Selected projects</h2>
    <div class="rows cv-rows">
      {projects.map((p) => (
        <div class="row">
          <span class="row-key">{p.meta}</span>
          <div>
            <span class="row-title">{p.title}</span>
            <p class="cv-stack">{p.stack}</p>
            <ul class="cv-bullets">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
    <a href="/projects" class="text-link cv-more">All projects <span class="arrow" aria-hidden="true">→</span></a>
  </section>

  {entrySections.map((s, i) => (
    <section class="wrap sect cv-sect" aria-labelledby={`cv-s${i}`}>
      <h2 id={`cv-s${i}`} class="label">{s.title}</h2>
      <div class="rows cv-rows">
        {s.items.map((e) => (
          <div class="row">
            <span class="row-key">{e.meta}</span>
            <div><span class="row-title">{e.name}</span><p class="row-desc">{e.desc}</p></div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap sect cv-sect" aria-labelledby="skills-h">
    <h2 id="skills-h" class="label">Skills</h2>
    <div class="rows cv-rows">
      {skills.map((s) => (
        <div class="row">
          <span class="row-key">{s.label}</span>
          <div><span class="row-val cv-skill">{s.value}</span></div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .cv-actions {
    margin-top: 28px;
  }

  .cv-mail {
    padding: 0 20px;
    font-weight: 400;
  }

  .cv-print-contact {
    display: none;
  }

  .cv-rows {
    margin-top: 24px;
  }

  .cv-stack {
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--label);
  }

  .cv-bullets {
    margin-top: 10px;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cv-bullets li {
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }

  .cv-skill {
    line-height: 1.55;
  }

  .cv-more {
    margin-top: 24px;
  }

  /* ---- Print: the public PDF. A4, always light, no nav, footer or buttons. ---- */
  @page {
    size: A4;
    margin: 13mm 14mm;
  }

  @media print {
    :global(:root) {
      --bg: #FFFFFF;
      --card: #FFFFFF;
      --quiet: #F2F2F0;
      --border: #E4E4E0;
      --border2: #D6D6D1;
      --text: #1E1E1E;
      --body: #45453F;
      --label: #5E5E5A;
      --accent: #86683A;
      --padx: 0px;
      color-scheme: light;
    }

    :global(body) {
      background: #FFFFFF;
      font-size: 10pt;
    }

    :global(.nav),
    :global(.footer),
    .cv-actions,
    .cv-more {
      display: none !important;
    }

    :global(.fade-pending) {
      opacity: 1 !important;
      transform: none !important;
    }

    .cv-head {
      padding: 0 0 4mm;
    }

    .cv-head :global(.page-h1) {
      margin-top: 1mm;
      font-size: 22pt;
    }

    .cv-sub {
      margin-top: 1.5mm;
      font-size: 10.5pt;
    }

    .cv-print-contact {
      display: block;
      margin-top: 1mm;
      font-size: 9pt;
      color: var(--label);
    }

    .cv-sect {
      padding-bottom: 4mm;
    }

    .cv-sect :global(.label) {
      font-size: 8pt;
      break-after: avoid-page;
    }

    /* keep each heading with its first row */
    .cv-rows {
      break-before: avoid-page;
    }

    .cv-rows :global(.row:first-child) {
      break-before: avoid-page;
    }

    .cv-rows {
      margin-top: 1.5mm;
    }

    .cv-rows :global(.row) {
      grid-template-columns: 30mm 1fr;
      gap: 5mm;
      padding: 1.8mm 0;
      break-inside: avoid;
    }

    .cv-rows :global(.row-key) {
      font-size: 8.5pt;
    }

    .cv-rows :global(.row-title),
    .cv-rows :global(.row-val) {
      font-size: 9.5pt;
      line-height: 1.4;
    }

    .cv-rows :global(.row-desc),
    .cv-bullets li {
      font-size: 8.8pt;
      line-height: 1.42;
    }

    .cv-stack {
      font-size: 8pt;
      margin-top: 0.5mm;
    }

    .cv-bullets {
      margin-top: 1mm;
      gap: 0.6mm;
    }
  }
</style>
