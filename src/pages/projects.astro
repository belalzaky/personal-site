---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { projectCases } from '../data/project-cases';
import { projectDisplay } from '../data/projects-v2';

// Copy from the V2-Projects boards; stakes from project-cases.ts. Order: newest first,
// as /projects has always been.
const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rows = projects.map((p, i) => {
  const d = projectDisplay[p.slug];
  return {
    n: String(i + 1).padStart(2, '0'),
    name: d?.name ?? p.data.title,
    big: d?.big ?? '',
    stake: projectCases[p.slug]?.stake ?? p.data.summary,
    tools: d?.tools ?? p.data.tags.join(' · '),
    href: `/projects/${p.slug}`,
  };
});
---

<Base
  title="Work — Belal Zaky"
  description="Projects on drug-safety data. Each one ends in a finding and a decision it should change."
>
  <section class="wrap page-head">
    <p class="label">Work</p>
    <h1 class="page-h1">Projects on drug-safety data. <span class="muted">Each one ends in a finding and a decision it should change.</span></h1>
    <p class="lead page-lead">Every project leads with what surprised me. The method and the code are one click further in.</p>
  </section>

  <section class="wrap sect" aria-label="All projects">
    <div class="list">
      {rows.map((r) => (
        <a href={r.href} class="row-link proj">
          <span class="proj-big">{r.big}</span>
          <span class="proj-main">
            <span class="proj-title">{r.n} · {r.name}</span>
            <span class="proj-stake">{r.stake}</span>
            <span class="proj-tools">{r.tools}</span>
          </span>
          <span class="proj-cta">Read <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .list {
    border-top: 1px solid var(--border);
  }

  .proj {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: baseline;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }

  .proj-big {
    font-size: 40px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent);
    white-space: nowrap;
  }

  .proj-main {
    display: block;
    min-width: 0;
  }

  .proj-title {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--label);
  }

  .proj-stake {
    display: block;
    margin-top: 6px;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text);
  }

  .proj-tools {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--label);
  }

  .proj-cta {
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .proj-big { font-size: 34px; }
    .proj { grid-template-columns: 170px 1fr auto; }
  }

  @media (max-width: 640px) {
    .proj {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 22px 0;
    }
    .proj-big { font-size: 34px; }
    .proj-big:empty { display: none; }
  }
</style>
