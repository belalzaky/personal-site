---
import Base from '../../layouts/Base.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { getCollection } from 'astro:content';

// Copy from the V2-Writing boards; posts from the collection, newest first. A post with a
// `url` links out to Substack; one without gets its own page on this site.
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Writing — Belal Zaky"
  description="Drug-safety evidence, written for people outside it."
>
  <section class="wrap page-head">
    <p class="label">Writing</p>
    <h1 class="page-h1">Drug-safety evidence, <span class="muted">written for people outside it.</span></h1>
  </section>

  <section class="wrap sect" aria-label="Posts">
    <div class="posts">
      {posts.map((p) => {
        const external = !!p.data.url;
        return (
          <a
            href={external ? p.data.url : `/writing/${p.slug}`}
            class="row-link post"
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <span class="post-date">{fmt(p.data.date)}</span>
            <span class="post-main">
              <span class="post-title">{p.data.title}</span>
              {p.data.summary && <span class="post-summary">{p.data.summary}</span>}
            </span>
            <span class="post-where">{external ? 'Substack ↗' : <>Read <span class="arrow" aria-hidden="true">→</span></>}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="wrap sect" data-fade>
    <EmailCapture />
  </section>
</Base>

<style>
  .posts {
    border-top: 1px solid var(--border);
  }

  .post {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: baseline;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .post-date {
    font-size: 13px;
    color: var(--label);
    white-space: nowrap;
  }

  .post-main {
    display: block;
    min-width: 0;
  }

  .post-title {
    display: block;
    font-size: var(--fs-body);
    line-height: 1.55;
    font-weight: 500;
    color: var(--text);
  }

  .post-summary {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }

  .post-where {
    font-size: 14px;
    color: var(--label);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .post {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 16px 0;
    }
  }
</style>
