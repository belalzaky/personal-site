---
import Case from '../../layouts/Case.astro';
import SignalThreshold from '../../components/viz/SignalThreshold.astro';
import EHRThreshold from '../../components/viz/EHRThreshold.astro';
import SqlSampling from '../../components/viz/SqlSampling.astro';
import SyntheaCohorts from '../../components/viz/SyntheaCohorts.astro';
import ZantacTrend from '../../components/viz/ZantacTrend.astro';
import SurvivalCurves from '../../components/viz/SurvivalCurves.astro';
import ADRScoreboard from '../../components/viz/ADRScoreboard.astro';
import ADRExplorer from '../../components/viz/ADRExplorer.astro';
import RweScoreboard from '../../components/viz/RweScoreboard.astro';
import PvPipeline from '../../components/viz/PvPipeline.astro';
import { getCollection } from 'astro:content';
import { projectCases } from '../../data/project-cases';
import { projectDisplay } from '../../data/projects-v2';

export async function getStaticPaths() {
  // Newest first, the /projects order; "Next" follows it and the last has none.
  const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((entry, i) => {
    const n = projects[i + 1];
    return {
      params: { slug: entry.slug },
      props: { entry, next: n ? { name: projectDisplay[n.slug]?.name ?? n.data.title, href: `/projects/${n.slug}` } : undefined },
    };
  });
}

const { entry, next } = Astro.props;
const { Content } = await entry.render();
const d = projectDisplay[entry.slug];
const c = projectCases[entry.slug];
---

<Case
  name={d?.name ?? entry.data.title}
  stake={c?.stake ?? entry.data.summary}
  description={entry.data.summary}
  tools={entry.data.tags.join(' · ')}
  github={entry.data.github}
  stats={d?.stats}
  finding={c?.finding}
  method={c?.method}
  decision={c?.decision}
  next={next}
>
  {entry.slug === 'faers-signal' && <SignalThreshold slot="chart" />}
  {entry.slug === 'ehr-ml' && <EHRThreshold slot="chart" />}
  {entry.slug === 'faers-sql' && <SqlSampling slot="chart" />}
  {entry.slug === 'synthea-ehr' && <SyntheaCohorts slot="chart" />}
  {entry.slug === 'faers-explorer' && <ZantacTrend slot="chart" />}
  {entry.slug === 'ehr-survival-r' && <SurvivalCurves slot="chart" />}
  {entry.slug === 'adr-reader' && (
    <div slot="chart" style="display:flex;flex-direction:column;gap:var(--space-8)">
      <ADRScoreboard />
      <ADRExplorer />
    </div>
  )}
  {entry.slug === 'rwe-causal' && <RweScoreboard slot="chart" />}
  {entry.slug === 'pv-intake' && <PvPipeline slot="chart" />}
  <Content />
</Case>
