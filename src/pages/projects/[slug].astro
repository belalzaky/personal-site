---
import Article from '../../layouts/Article.astro';
import SignalThreshold from '../../components/viz/SignalThreshold.astro';
import EHRThreshold from '../../components/viz/EHRThreshold.astro';
import SqlSampling from '../../components/viz/SqlSampling.astro';
import SyntheaCohorts from '../../components/viz/SyntheaCohorts.astro';
import ZantacTrend from '../../components/viz/ZantacTrend.astro';
import SurvivalCurves from '../../components/viz/SurvivalCurves.astro';
import ADRScoreboard from '../../components/viz/ADRScoreboard.astro';
import ADRExplorer from '../../components/viz/ADRExplorer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Article
  title={entry.data.title}
  date={entry.data.date}
  showDate={false}
  dek={entry.data.summary}
  description={entry.data.summary}
  tags={entry.data.tags}
  image={entry.data.image}
>
  {entry.slug === 'faers-signal' && <SignalThreshold slot="chart" />}
  {entry.slug === 'ehr-ml' && <EHRThreshold slot="chart" />}
  {entry.slug === 'faers-sql' && <SqlSampling slot="chart" />}
  {entry.slug === 'synthea-ehr' && <SyntheaCohorts slot="chart" />}
  {entry.slug === 'faers-explorer' && <ZantacTrend slot="chart" />}
  {entry.slug === 'ehr-survival-r' && <SurvivalCurves slot="chart" />}
  {entry.slug === 'adr-reader' && (
    <div slot="chart" style="display:flex;flex-direction:column;gap:var(--space-8)">
      <ADRScoreboard />
      <ADRExplorer />
    </div>
  )}
  <Content />
</Article>
