---
import Base from '../layouts/Base.astro';
// About: a wall of four photos with the About text in three small cells between them.
// These four photos are used nowhere else on the site (Belal's rule, 18 Nov).
const sent = [
  'I’m in my second year of MSci Pharmacology at King’s, and I split my time between London and Dubai.',
  'Most of my work is on drug-safety data, looking for where the obvious analysis gives the wrong answer, and outside the degree I build the tools I use to run my week.',
  'I train most evenings, I’m setting up LIFTKCL as a beginner-friendly gym society at King’s, and I take photos wherever I am.',
];
const ph = { work: '50% 40%', night: '52% 50%', coffee: '40% 45%', sky: '50% 48%' } as const;
const alt = { work: 'Me at my laptop at night, in headphones and orange-tinted glasses', night: 'A low-angle selfie at night in a black puffer jacket', coffee: 'Looking down at an iced coffee in my hand, black puffer and jeans', sky: 'A low-angle shot of me against a grey sky, earphones in' } as const;
const meta = [
  { k: 'based', v: 'london | dubai' }, { k: 'studying', v: 'msci pharmacology' }, { k: 'training', v: 'most evenings' },
  { k: 'looking for', v: '2027/28 placement, pharma' }, { k: 'cv', v: 'pdf', href: '/Belal-Zaky-CV.pdf' }, { k: 'email', v: 'hello@belalzaky.uk', href: 'mailto:hello@belalzaky.uk' },
];
const P = (k: keyof typeof ph, col: string, row: string, o: number, cls = '') => ({ k, style: `grid-column:${col};grid-row:${row};--o:${o}`, cls });
const photos = [P('work', '1 / 3', '1 / 4', 0, 'tall'), P('night', '3', '1 / 3', 1, 'half'), P('coffee', '4', '2 / 4', 1, 'half'), P('sky', '5 / 7', '1 / 3', 3, 'tall')];
const texts = [
  { i: 0, l: 'degree', style: 'grid-column:3;grid-row:3;--o:2' },
  { i: 1, l: 'work', style: 'grid-column:4;grid-row:1;--o:2' },
  { i: 2, l: 'outside', style: 'grid-column:5;grid-row:3;--o:4' },
];
---

<Base title="About · Belal Zaky" description="Second-year MSci Pharmacology at King's, between London and Dubai. Drug-safety data, tools I build, lifting and photos." shape="screen" current="about" meta={meta}>
  <main class="main wall in-anim" id="wall">
    <h1 class="sr-only">About me</h1>
    {photos.map((p) => (
      <div class:list={['c', 'pad0', 'ph2', p.cls]} style={p.style} data-ph={p.k} tabindex="0">
        <img src={`/photos/about/${p.k}.jpg`} style={`object-position:${ph[p.k]}`} alt={alt[p.k]} loading="eager" decoding="async" />
        <span class="lbl">{p.k}.jpg</span>
      </div>
    ))}
    {texts.map((t) => (
      <div class="c txt" style={t.style}><span class="lbl top">0{t.i + 1} · {t.l}</span><p>{sent[t.i]}</p></div>
    ))}
    <div class="c contact" style="grid-column:6;grid-row:3;--o:5">
      <span class="lbl top">contact</span>
      <a class="go" href="mailto:hello@belalzaky.uk">hello@belalzaky.uk</a>
      <a class="go" href="/Belal-Zaky-CV.pdf">cv (pdf) <span class="arr">→</span></a>
      <a class="go" href="/writing">writing <span class="arr">→</span></a>
    </div>
  </main>
</Base>

<style>
  .ph2 { background: var(--photo); }
  .ph2 img { width: 100%; height: 100%; object-fit: cover; transition: opacity .3s ease, transform .8s var(--out); }
  .ph2 .lbl { position: absolute; left: 8px; bottom: 8px; background: var(--cell); color: var(--ink); padding: 1px 6px; opacity: 0; transition: opacity .2s ease; }
  .ph2.hot .lbl { opacity: 1; }
  .ph2.hot img { transform: scale(1.04); }
  .wall.dim .ph2:not(.hot) img { opacity: .28; }
  .txt p { font-size: 14px; line-height: 1.4; margin: 0; }
  @media (max-width: 700px) {
    .wall > .c { order: var(--o, 0); }
    .ph2 { aspect-ratio: 3 / 4; }
  }
  @media (max-width: 700px) {
    .contact { gap: 0; padding: 14px 16px 6px; }
    .contact .go { display: flex; align-items: center; min-height: 44px; font-size: 16px; border-top: 1px solid var(--gap); }
    .contact .lbl.top { margin-bottom: 8px; }
  }
</style>

<script>
  import { setMeta, resetMeta } from '../scripts/site';
  const wall = document.getElementById('wall')!;
  const ph = [...wall.querySelectorAll<HTMLElement>('.ph2')];
  const on = (p: HTMLElement) => { wall.classList.add('dim'); ph.forEach((x) => x.classList.toggle('hot', x === p)); setMeta([['photo', p.dataset.ph + '.jpg']]); };
  const off = () => { wall.classList.remove('dim'); ph.forEach((x) => x.classList.remove('hot')); resetMeta(); };
  ph.forEach((p) => { p.addEventListener('mouseenter', () => on(p)); p.addEventListener('focus', () => on(p)); p.addEventListener('mouseleave', off); p.addEventListener('blur', off); });
</script>
