---
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Photography from '../components/Photography.astro';
---

<Base
  title="About — Belal Zaky"
  description="BSc Pharmacology student at King's College London exploring pharmacovigilance and health data science — building signal detection, EHR, and drug safety projects in Python and SQL."
>
  <div class="page">

    <!-- §3 · ABOUT — bio + facts card -->
    <section class="about-intro container">
      <header class="about-intro-head reveal">
        <p class="page-eyebrow">03 · ABOUT</p>
        <h1 class="page-title">About</h1>
      </header>

      <div class="about-grid">
        <div class="about-bio reveal">
          <p class="about-lead">
            I'm a first-year pharmacology student at King's — more interested in what
            medicine's <span class="accent">data</span> can tell us than most of my cohort.
          </p>
          <p class="about-bio-text">
            Most people in drug safety aren't strong on data; most data people don't know
            drug safety. I'm building toward the rare spot where drug-safety data, AI, and
            <span class="accent">policy</span> meet — and the decisions that get made there.
            I teach myself the technical side (R, Python, SQL, ML) and build everything in public.
          </p>
        </div>

        <aside class="facts-card reveal" style="--reveal-delay:80ms">
          <img
            src="/headshot.jpg"
            srcset="/headshot.jpg 1x, /headshot@2x.jpg 2x"
            alt="Belal Zaky"
            class="facts-photo"
            width="280"
            height="350"
            loading="lazy"
          />
          <dl class="facts-list">
            <div class="facts-row">
              <dt class="facts-key">Studying</dt>
              <dd class="facts-val">Pharmacology, King's College London</dd>
            </div>
            <div class="facts-row">
              <dt class="facts-key">Based</dt>
              <dd class="facts-val">London &amp; Dubai</dd>
            </div>
            <div class="facts-row">
              <dt class="facts-key">Heading</dt>
              <dd class="facts-val">Health data, AI &amp; policy</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <!-- Journey, skills, education, contact -->
    <div class="about-body container container--prose">

      <!-- THE JOURNEY -->
      <section class="about-section">
        <h2 class="about-section-title">The journey</h2>

        <ol class="timeline" role="list">
          <li class="timeline-item reveal">
            <span class="timeline-date">2025</span>
            <div class="timeline-content">
              <p class="timeline-desc">Couldn't write a line of Python. Started learning data — in public.</p>
            </div>
          </li>
          <li class="timeline-item reveal">
            <span class="timeline-date">Early 2026</span>
            <div class="timeline-content">
              <p class="timeline-desc">First project shipped: a live FAERS adverse-event dashboard.</p>
            </div>
          </li>
          <li class="timeline-item reveal">
            <span class="timeline-date">Spring 2026</span>
            <div class="timeline-content">
              <p class="timeline-desc">SQL, synthetic EHR, and pharmacovigilance signal detection.</p>
            </div>
          </li>
          <li class="timeline-item reveal">
            <span class="timeline-date">Mid 2026</span>
            <div class="timeline-content">
              <p class="timeline-desc">First ML model, then survival analysis in R — six projects, all interactive.</p>
            </div>
          </li>
          <li class="timeline-item timeline-item--accent reveal">
            <span class="timeline-date">Next</span>
            <div class="timeline-content">
              <p class="timeline-desc timeline-desc--accent">An industry-facing master's — bridging drug-safety data, AI, and the policy built on it.</p>
            </div>
          </li>
        </ol>
      </section>

      <!-- Skills & tools -->
      <section class="about-section">
        <h2 class="about-section-title">Skills &amp; tools</h2>
        <p class="about-note">Self-taught alongside my degree — still learning.</p>

        <dl class="skills-list">
          <div class="skills-row">
            <dt class="skills-label">Data</dt>
            <dd class="skills-value">Python, pandas, SQL, SQLite, scikit-learn, matplotlib</dd>
          </div>
          <div class="skills-row">
            <dt class="skills-label">Tools</dt>
            <dd class="skills-value">Git &amp; GitHub, Streamlit, openFDA API</dd>
          </div>
          <div class="skills-row">
            <dt class="skills-label">Domain</dt>
            <dd class="skills-value">Pharmacology, pharmacovigilance, real-world-evidence basics</dd>
          </div>
        </dl>
      </section>

      <!-- Education & activities -->
      <section class="about-section">
        <h2 class="about-section-title">Education &amp; activities</h2>

        <ul class="edu-list" role="list">
          <li class="edu-item">
            <span class="edu-name">BSc Pharmacology (Hons), King's College London</span>
            <span class="edu-detail">Expected 2028</span>
          </li>
          <li class="edu-item">
            <span class="edu-name">Toastmasters International</span>
            <span class="edu-detail">Member &amp; Sergeant at Arms</span>
          </li>
          <li class="edu-item">
            <span class="edu-name">King's100 Leadership &amp; Employability Programme</span>
          </li>
          <li class="edu-item">
            <span class="edu-name">Student Representative, BSc Pharmacology</span>
          </li>
          <li class="edu-item">
            <span class="edu-name">Model United Nations</span>
            <span class="edu-detail">Delegate</span>
          </li>
        </ul>
      </section>

      <!-- Beyond the work -->
      <section class="about-section">
        <h2 class="about-section-title">Beyond the work</h2>
        <p class="about-beyond">
          Public speaking, languages (English &amp; Arabic), and splitting time between London and Dubai.
        </p>
      </section>

    </div>

    <!-- Photography strip — full width -->
    <section class="lens-section" aria-label="Through the lens">
      <div class="container container--prose">
        <h2 class="lens-heading">Through the lens</h2>
      </div>
      <Photography />
    </section>

    <!-- Contact -->
    <div class="about-contact container container--prose">
      <ContactBlock />
    </div>

  </div>
</Base>

<style>
  .page {
    padding-top: var(--space-16);
    padding-bottom: var(--space-24);
  }

  /* Page header */
  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
    max-width: none;
  }

  .page-title {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: var(--text-2xl);
    }
  }

  /* §3 intro: bio + facts card */
  .about-intro {
    padding-bottom: var(--space-16);
  }

  .about-intro-head {
    margin-bottom: var(--space-10);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-12);
    align-items: start;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .about-bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-lead {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text);
    max-width: 30ch;
  }

  @media (max-width: 640px) {
    .about-lead {
      font-size: var(--text-xl);
    }
  }

  .about-bio-text {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 60ch;
  }

  .accent {
    color: var(--color-accent);
  }

  /* Facts card */
  .facts-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    position: sticky;
    top: 80px;
  }

  @media (max-width: 760px) {
    .facts-card {
      position: static;
    }
  }

  .facts-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    display: block;
  }

  .facts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .facts-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .facts-key {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .facts-val {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.5;
  }

  /* Body sections */
  .about-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-section-title {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .about-section-tagline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    max-width: none;
  }

  .about-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .about-beyond {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .about-contact {
    padding-top: var(--space-4);
  }

  /* Timeline */
  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid var(--color-border);
    margin-left: var(--space-4);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-6);
    padding: var(--space-4) 0 var(--space-4) var(--space-6);
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -4px;
    top: calc(var(--space-4) + 6px);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .timeline-item--accent::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .timeline-desc--accent {
    color: var(--color-text);
    font-weight: 500;
  }

  @media (max-width: 540px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  .timeline-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.02em;
    padding-top: 2px;
    white-space: nowrap;
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .timeline-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 1px 7px;
    border-radius: var(--radius-sm);
    width: fit-content;
    font-weight: 500;
  }

  .timeline-project {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
    line-height: 1.4;
  }

  .timeline-project:hover {
    color: var(--color-accent);
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 48ch;
  }

  /* Skills */
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .skills-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-6);
    align-items: baseline;
  }

  @media (max-width: 480px) {
    .skills-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  .skills-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .skills-value {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.6;
  }

  /* Education */
  .edu-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .edu-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .edu-name {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }

  .edu-detail {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* Photography strip */
  .lens-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  .lens-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .about-contact {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
  }
</style>
