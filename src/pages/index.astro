---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedWorkCard from '../components/FeaturedWorkCard.astro';
import ADRExplorer from '../components/viz/ADRExplorer.astro';
import RweScoreboard from '../components/viz/RweScoreboard.astro';
import PvPipeline from '../components/viz/PvPipeline.astro';
import SocialProof from '../components/SocialProof.astro';
import Positions from '../components/Positions.astro';
import WritingItem from '../components/WritingItem.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getCollection } from 'astro:content';
import { projectCases } from '../data/project-cases';

const SUBSTACK_HOME = 'https://belalzaky.substack.com';
const isPublished = (url?: string) => !!url && url.replace(/\/$/, '') !== SUBSTACK_HOME;

// Single source of truth — derived, never hand-typed.
const projectCount = (await getCollection('projects')).length;
const WORDS = ['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve'];
const countWord = WORDS[projectCount] ?? String(projectCount);

const allPosts = await getCollection('posts');
const latestPost = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter(p => isPublished(p.data.url))
  .slice(0, 1);
---

<Base title="Belal Zaky — most of what a drug's data appears to say is an artefact of how it was collected" description="A pharmacology student at King's turning uncertain drug-safety evidence into decisions. Nine shipped projects on adverse events, causal inference and AI — and the positions they left me with.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Belal Zaky",
      "jobTitle": "Pharmacology student",
      "url": "https://belalzaky.uk",
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "King's College London"
      },
      "sameAs": [
        "https://linkedin.com/in/belalzaky",
        "https://github.com/belalzaky",
        "https://belalzaky.substack.com"
      ]
    })} />
  </Fragment>
  <Hero />

  <section class="section container">
    <header class="section-header">
      <div class="section-heading">
        <p class="section-eyebrow">01 · FEATURED WORK</p>
        <h2 class="section-title">Three findings worth your 30 seconds.</h2>
      </div>
    </header>

    <div class="featured-work-stack">
      <FeaturedWorkCard
        {...projectCases['rwe-causal']}
        tags={["Python", "Causal inference", "SCCS"]}
        href="/projects/rwe-causal"
        delay={0}
      >
        <RweScoreboard slot="interactive" />
      </FeaturedWorkCard>

      <FeaturedWorkCard
        {...projectCases['adr-reader']}
        tags={["Python", "PubMedBERT", "LLM eval"]}
        href="/projects/adr-reader"
        github="https://github.com/belalzaky/adr-reader"
        delay={80}
      >
        <ADRExplorer slot="interactive" />
      </FeaturedWorkCard>

      <FeaturedWorkCard
        {...projectCases['pv-intake']}
        tags={["Python", "NLP", "SNOMED CT", "Docker"]}
        href="/projects/pv-intake"
        github="https://github.com/belalzaky/pv-intake"
        delay={160}
      >
        <PvPipeline slot="interactive" />
      </FeaturedWorkCard>
    </div>

    <div class="featured-work-cta">
      <a href="/projects" class="btn btn-primary">Explore all {countWord} projects →</a>
    </div>
  </section>

  <section class="section container">
    <header class="section-header">
      <div class="section-heading">
        <p class="section-eyebrow">02 · GROUNDED IN THE FIELD</p>
        <h2 class="section-title">Not just built in a classroom.</h2>
      </div>
    </header>
    <p class="section-intro reveal">
      The questions come from people who do this for a living — drug safety teams whose
      conclusions end up in front of regulators, courts and boards. The work is checked the
      way theirs is: against cases where the answer is already known.
    </p>
    <SocialProof />
  </section>

  <section class="section container">
    <header class="section-header">
      <div class="section-heading">
        <p class="section-eyebrow">03 · WHAT I THINK</p>
        <h2 class="section-title">Three things I'd argue for.</h2>
      </div>
    </header>
    <p class="section-intro reveal">
      A finding is not a view. These are the positions the work above has left me with —
      each one with the evidence behind it, and the thing that would change my mind.
    </p>
    <Positions />
  </section>

  {latestPost.length > 0 && (
    <section class="section container container--prose">
      <header class="section-header">
        <div class="section-heading">
          <p class="section-eyebrow">04 · WRITING</p>
          <h2 class="section-title">Latest writing</h2>
        </div>
        <a href="/writing" class="section-more">All posts →</a>
      </header>
      <ul role="list" class="writing-list">
        {latestPost.map(post => (
          <WritingItem
            title={post.data.title}
            date={post.data.date}
            summary={post.data.summary}
            href={post.data.url}
          />
        ))}
      </ul>
    </section>
  )}

  <section class="section container container--prose">
    <ContactBlock />
  </section>
</Base>

<style>
  .section {
    padding-bottom: var(--space-24);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    gap: var(--space-4);
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    max-width: none;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .section-more {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
    white-space: nowrap;
    padding-bottom: var(--space-1);
  }

  .section-more:hover {
    color: var(--color-accent);
  }

  .section-intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 64ch;
    margin-top: calc(-1 * var(--space-4));
    margin-bottom: var(--space-8);
  }

  .featured-work-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .featured-work-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-16);
  }

  .writing-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
</style>
