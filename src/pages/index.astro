---
import Base from '../layouts/Base.astro';
import { now, placementStart } from '../data/now';
import { words } from '../data/index-words';
const first = words[0];
---

<Base title="Belal Zaky" shape="screen" current="index"
  meta={first.meta.map(([k, v, href]) => ({ k, v, href }))}>
  <main class="main main--col idx">
    <h1 class="sr-only">Belal Zaky: health, tech, build, lifestyle. London | Dubai.</h1>
    <div class="info in-anim">
      {now.map((r) => (
        <div class="c half"><span class="lbl top">now · {r.k}</span><p class="small now-v">{r.v}</p></div>
      ))}
      <div class="c wide" data-cd={placementStart}>
        <span class="lbl top">until the placement year starts · sep 2027</span>
        <div class="cd"><b data-u="d">0</b><span>days</span><b data-u="h">00</b><span>h</span><b data-u="m">00</b><span>m</span></div>
      </div>
    </div>
    <div class="words in-anim">
      {words.map((w, i) => (
        <a class:list={['wrow', { on: i === 0 }]} href={w.href} data-w={i} data-meta={JSON.stringify(w.meta)} data-n={w.photos.length}>
          <span class="bg" aria-hidden="true">
            {w.photos.map((p, n) => (
              <picture>
                <source media="(max-width: 700px)" srcset={`/photos/index/${p}-p.jpg`} />
                <img src={`/photos/index/${p}-d.jpg`} alt="" class:list={{ show: n === 0 }} loading={i === 0 && n === 0 ? 'eager' : 'lazy'} decoding="async" />
              </picture>
            ))}
          </span>
          <span class="lbl sub">0{i + 1} · {w.sub}</span>
          <span class="w" aria-hidden="true">{[...w.w].map((x, j) => <span class="ch" style={`--i:${j}`} data-c={x}>{x}</span>)}</span>
          <span class="sr-only">{w.w}: {w.sub}. Go to {w.go}.</span>
          <span class="lbl gol">{w.go} <span class="arr">→</span></span>
          <span class="lbl cap"></span>
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  .idx { gap: 1px; }
  .info { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; flex: 0 0 104px; }
  .info .wide { grid-column: span 2; }
  .cd { display: flex; align-items: baseline; gap: 10px; font-variant-numeric: tabular-nums; flex-wrap: wrap; }
  .cd b { font-size: clamp(26px, 2.9vw, 42px); font-weight: 500; letter-spacing: -.04em; line-height: 1; }
  .cd span { font-family: var(--mono); font-size: 12px; color: var(--mute); }
  .words { flex: 1; display: flex; flex-direction: column; gap: 1px; min-height: 0; }
  .wrow { position: relative; flex: 0 0 clamp(56px, 6.2vw, 84px); min-height: 0; width: 100%; background: var(--cell); display: grid; grid-template-columns: minmax(150px, 16.6%) 1fr auto; gap: 12px; align-items: center; padding: 0 12px; overflow: hidden; transition: flex-grow .7s var(--out); }
  .wrow.on { flex-grow: 1; }
  .bg { position: absolute; left: 0; right: 0; top: 50%; aspect-ratio: 3 / 1; transform: translateY(-50%); background: var(--photo); opacity: 0; transition: opacity .5s ease; }
  .bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.1s ease; }
  .bg img.show { opacity: 1; }
  .bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.55), rgba(0,0,0,.1) 70%); }
  .wrow.on .bg { opacity: 1; }
  .wrow > .lbl, .w { position: relative; z-index: 1; transition: color .3s ease; }
  .w { font-size: clamp(30px, 4.4vw, 64px); font-weight: 560; letter-spacing: -.045em; line-height: 1.14; display: flex; overflow: hidden; height: 1.14em; white-space: nowrap; }
  .ch { display: inline-block; position: relative; transition: transform 1.2s var(--out); transition-delay: calc(var(--i) * 30ms); }
  .ch::after { content: attr(data-c); position: absolute; left: 0; top: 100%; }
  .wrow.on .ch { transform: translateY(-100%); }
  .wrow.on .w, .wrow.on > .lbl { color: var(--onph); }
  .now-v { white-space: pre-line; }
  .wrow > .sub { text-transform: none; }
  .wrow > .cap { position: absolute; right: 12px; bottom: 10px; z-index: 1; opacity: 0; transition: opacity .3s ease; }
  .wrow.on > .cap { opacity: .85; }
  .wrow:focus-visible { outline-offset: -3px; }
  /* phone: the words come first, each a photo-sized row, and the one in the middle of the
     screen opens as you scroll past; rows keep their height so nothing jumps */
  @media (max-width: 700px) {
    .words { order: -1; flex: 0 0 auto; }
    .info { grid-template-columns: 1fr 1fr; flex: 0 0 auto; }
    .info .c { min-height: 96px; padding: 14px 16px; }
    .wrow, .wrow.on { flex: 0 0 auto; height: 75vw; grid-template-columns: 1fr auto; grid-template-rows: 1fr auto auto; gap: 2px 8px; align-items: end; padding: 14px 16px; }
    .wrow > .sub { grid-column: 1 / -1; grid-row: 2; }
    .wrow > .w { grid-row: 3; }
    .wrow > .gol { grid-row: 3; align-self: center; }
    .wrow > .cap { top: 14px; bottom: auto; right: 16px; }
    .bg { top: 0; bottom: 0; transform: none; aspect-ratio: auto; opacity: .1; filter: grayscale(1); transition: opacity .6s ease, filter .6s ease; }
    .wrow.on .bg { opacity: 1; filter: none; }
    .bg::after { background: linear-gradient(0deg, rgba(0,0,0,.62), rgba(0,0,0,.18) 45%, rgba(0,0,0,0) 70%); }
    .w { font-size: 17vw; }
  }
</style>

<script>
  import { setMeta, reduced } from '../scripts/site';
  // countdown, a minute at a time
  const cd = document.querySelector<HTMLElement>('[data-cd]');
  if (cd) {
    const target = new Date(cd.dataset.cd!).getTime();
    const tick = () => {
      const ms = Math.max(0, target - Date.now());
      const set = (u: string, v: string) => { const e = cd.querySelector(`[data-u="${u}"]`); if (e) e.textContent = v; };
      set('d', String(Math.floor(ms / 864e5)));
      set('h', String(Math.floor(ms / 36e5) % 24).padStart(2, '0'));
      set('m', String(Math.floor(ms / 6e4) % 60).padStart(2, '0'));
    };
    tick(); setInterval(tick, 20000);
  }
  // the four words: hover or focus opens a row onto its photos, which fade every 3 s.
  // On a phone the row in the middle of the screen opens as you scroll, and a tap follows the link.
  const rows = [...document.querySelectorAll<HTMLAnchorElement>('.wrow')];
  const idx = rows.map(() => 0);
  let open = 0, iv = 0;
  const cap = (r: HTMLElement) => { const i = +r.dataset.w!, n = +r.dataset.n!; r.querySelector('.cap')!.textContent = `${idx[i] + 1}/${n}`; };
  const show = (r: HTMLElement) => { const i = +r.dataset.w!; r.querySelectorAll('.bg img').forEach((im, n) => im.classList.toggle('show', n === idx[i])); cap(r); };
  const tick = () => { const r = rows[open], n = +r.dataset.n!; if (n < 2) return; idx[open] = (idx[open] + 1) % n; show(r); };
  const cycle = () => { clearInterval(iv); if (!reduced) iv = window.setInterval(tick, 3000); };
  const activate = (r: HTMLElement) => {
    const i = +r.dataset.w!;
    if (open === i && r.classList.contains('on')) return;
    open = i; rows.forEach((x) => x.classList.toggle('on', x === r));
    idx[i] = 0; show(r); setMeta(JSON.parse(r.dataset.meta!)); cycle();
  };
  const phone = window.matchMedia('(max-width: 700px)');
  rows.forEach((r) => {
    cap(r);
    r.addEventListener('mouseenter', () => { if (!phone.matches && matchMedia('(hover: hover)').matches) activate(r); });
    r.addEventListener('focus', () => activate(r));
  });
  const mid = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting && phone.matches) activate(e.target as HTMLElement); }), { rootMargin: '-48% 0px -48% 0px' });
  rows.forEach((r) => mid.observe(r));
  cycle();
</script>
