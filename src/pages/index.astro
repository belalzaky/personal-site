---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedWorkCard from '../components/FeaturedWorkCard.astro';
import SignalThreshold from '../components/viz/SignalThreshold.astro';
import SurvivalCurves from '../components/viz/SurvivalCurves.astro';
import ADRExplorer from '../components/viz/ADRExplorer.astro';
import SocialProof from '../components/SocialProof.astro';
import WritingItem from '../components/WritingItem.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getCollection } from 'astro:content';

const SUBSTACK_HOME = 'https://belalzaky.substack.com';
const isPublished = (url?: string) => !!url && url.replace(/\/$/, '') !== SUBSTACK_HOME;

const allPosts = await getCollection('posts');
const latestPost = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter(p => isPublished(p.data.url))
  .slice(0, 1);
---

<Base title="Belal Zaky — Pharmacovigilance & Health Data Projects" description="Pharmacology student at King's College London building pharmacovigilance and health data science projects in Python, SQL, and machine learning.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Belal Zaky",
      "jobTitle": "Pharmacology student",
      "url": "https://belalzaky.uk",
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "King's College London"
      },
      "sameAs": [
        "https://linkedin.com/in/belalzaky",
        "https://github.com/belalzaky",
        "https://belalzaky.substack.com"
      ]
    })} />
  </Fragment>
  <Hero>
    <SignalThreshold slot="interactive" />
  </Hero>

  <section class="section container">
    <header class="section-header">
      <div class="section-heading">
        <p class="section-eyebrow">01 · FEATURED WORK</p>
        <h2 class="section-title">Three things worth your 30 seconds.</h2>
      </div>
    </header>

    <div class="featured-work-stack">
      <FeaturedWorkCard
        hook="I taught four AIs to read medical notes for drug side effects. The fanciest one came last."
        problem="Which model actually catches a dangerous drug side effect buried in a doctor's note?"
        found="A domain-tuned model won; a plain keyword model beat a general-purpose transformer; a zero-shot LLM over-flagged and hallucinated details."
        tags={["Python", "PubMedBERT", "LLM eval"]}
        href="/projects/adr-reader"
        delay={0}
      >
        <ADRExplorer slot="interactive" />
      </FeaturedWorkCard>

      <FeaturedWorkCard
        hook="Is a spike in side-effect reports a real danger, or just noise? I built the detector that tells them apart."
        problem="A drug's adverse-event reports spike — is that a real safety signal or a reporting artefact?"
        found="A disproportionality detector over 20M FAERS reports, validated on the known warfarin–haemorrhage signal and checked against negative controls."
        tags={["Python", "pandas", "openFDA API"]}
        href="/projects/faers-signal"
        github="https://github.com/belalzaky/faers-signal"
        delay={80}
      >
        <SignalThreshold slot="interactive" />
      </FeaturedWorkCard>

      <FeaturedWorkCard
        hook="How long until a patient develops hypertension — and what a 'nothing' result was really hiding."
        problem="Not just whether a patient gets hypertension, but how long it takes — and what changes that."
        found="Diabetic patients develop hypertension roughly 2.4× faster; an apparently null age effect turned out to be time-varying, not actually absent."
        tags={["R", "survival", "Cox regression"]}
        href="/projects/ehr-survival-r"
        github="https://github.com/belalzaky/ehr-survival-r"
        delay={160}
      >
        <SurvivalCurves slot="interactive" />
      </FeaturedWorkCard>
    </div>

    <div class="featured-work-cta">
      <a href="/projects" class="btn btn-primary">Explore all seven projects →</a>
    </div>
  </section>

  <section class="section container">
    <header class="section-header">
      <div class="section-heading">
        <p class="section-eyebrow">02 · GROUNDED IN THE FIELD</p>
        <h2 class="section-title">Not just built in a classroom.</h2>
      </div>
    </header>
    <p class="section-intro reveal">
      The projects come from real pharmacovigilance practice — practitioners' frameworks and
      advice, turned into working code — the technical foundation for better drug-safety
      decisions and policy.
    </p>
    <SocialProof />
  </section>

  {latestPost.length > 0 && (
    <section class="section container container--prose">
      <header class="section-header">
        <div class="section-heading">
          <p class="section-eyebrow">03</p>
          <h2 class="section-title">Latest writing</h2>
        </div>
        <a href="/writing" class="section-more">All posts →</a>
      </header>
      <ul role="list" class="writing-list">
        {latestPost.map(post => (
          <WritingItem
            title={post.data.title}
            date={post.data.date}
            summary={post.data.summary}
            href={post.data.url}
          />
        ))}
      </ul>
    </section>
  )}

  <section class="section container container--prose">
    <ContactBlock />
  </section>
</Base>

<style>
  .section {
    padding-bottom: var(--space-24);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    gap: var(--space-4);
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    max-width: none;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .section-more {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
    white-space: nowrap;
    padding-bottom: var(--space-1);
  }

  .section-more:hover {
    color: var(--color-accent);
  }

  .section-intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 64ch;
    margin-top: calc(-1 * var(--space-4));
    margin-bottom: var(--space-8);
  }

  .featured-work-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .featured-work-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  .writing-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
</style>
