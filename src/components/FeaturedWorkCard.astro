---
interface Props {
  hook: string;
  problem: string;
  found: string;
  tags: string[];
  href: string;
  github?: string;
  link?: string;
  delay?: number;
}

const { hook, problem, found, tags, href, github, link, delay = 0 } = Astro.props;
const hasInteractive = Astro.slots.has('interactive');
---

<article class="fwcard reveal" style={`--reveal-delay:${delay}ms`}>
  <div class="fwcard-top">
    <span class="fwcard-badge">◆ INTERACTIVE</span>
    <ul class="fwcard-tags" role="list" aria-label="Stack">
      {tags.map((t) => <li class="tag" role="listitem">{t}</li>)}
    </ul>
  </div>

  <div class={hasInteractive ? 'fwcard-body' : 'fwcard-body fwcard-body--solo'}>
    <div class="fwcard-info">
      <h3 class="fwcard-hook">
        <a href={href} class="fwcard-link">{hook}</a>
      </h3>

      <div class="fwcard-case">
        <p class="fwcard-problem">
          <span class="fwcard-k">Problem</span>{problem}
        </p>
        <p class="fwcard-found">
          <span class="fwcard-k fwcard-k--found">What I found</span>{found}
        </p>
      </div>

      <div class="fwcard-footer">
        <a href={href} class="fwcard-cta" aria-label={`View project: ${hook}`}>
          View project <span aria-hidden="true">→</span>
        </a>
        <div class="fwcard-ext">
          {link && (
            <a href={link} class="fwcard-ext-link" target="_blank" rel="noopener noreferrer">Live ↗</a>
          )}
          {github && (
            <a href={github} class="fwcard-ext-link" target="_blank" rel="noopener noreferrer">GitHub</a>
          )}
        </div>
      </div>
    </div>

    {hasInteractive && (
      <div class="fwcard-interactive">
        <slot name="interactive" />
      </div>
    )}
  </div>
</article>

<style>
  .fwcard {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    transition: border-color var(--dur) var(--ease);
  }

  .fwcard:hover {
    border-color: var(--color-accent);
  }

  .fwcard-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .fwcard-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    white-space: nowrap;
  }

  .fwcard-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-left: auto;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    font-weight: 500;
  }

  .fwcard-body {
    display: grid;
    grid-template-columns: minmax(280px, 360px) 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .fwcard-body--solo {
    grid-template-columns: 1fr;
  }

  @media (max-width: 900px) {
    .fwcard-body {
      grid-template-columns: 1fr;
    }
  }

  .fwcard-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }

  .fwcard-hook {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .fwcard-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .fwcard-link:hover {
    color: var(--color-accent);
  }

  .fwcard-case {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 68ch;
  }

  .fwcard-k {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: 3px;
  }

  .fwcard-k--found {
    color: var(--color-accent);
  }

  .fwcard-problem {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .fwcard-found {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 500;
    line-height: 1.6;
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-3);
  }

  .fwcard-interactive {
    padding-top: var(--space-2);
  }

  .fwcard-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .fwcard-cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .fwcard-cta:hover {
    color: var(--color-accent-hover);
  }

  .fwcard-ext {
    display: flex;
    gap: var(--space-3);
  }

  .fwcard-ext-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .fwcard-ext-link:hover {
    color: var(--color-text);
  }
</style>
