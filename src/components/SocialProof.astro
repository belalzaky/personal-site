---
// §3 — Social proof: grounded in real pharmacovigilance practice.
// Soft attribution only, no names.
import { getCollection } from 'astro:content';

// Single source of truth — derived, never hand-typed.
const projectCount = (await getCollection('projects')).length;

const stats = [
  { value: String(projectCount), label: 'projects shipped in public' },
  { value: '1.19 → 2.20', label: 'confounding caught against a sealed truth' },
  { value: '20M+', label: 'FAERS reports analysed' },
  { value: '4 models', label: 'benchmarked — the most expensive one lost' },
  { value: 'CI · Docker', label: 'tested, containerised pipeline' },
];
---

<div class="proof">
  <div class="proof-cards">
    <figure class="proof-card reveal">
      <blockquote class="proof-quote">
        “A litigation flood shows attention; a real safety signal shows a pattern.”
      </blockquote>
      <figcaption class="proof-attrib">— a working pharmacovigilance professional.</figcaption>
      <p class="proof-context">
        Advice from practitioners in the field shaped the direction this whole portfolio follows.
      </p>
    </figure>

    <figure class="proof-card reveal" style="--reveal-delay:80ms">
      <p class="proof-lead">
        A crude comparison said the risk was 1.19. The real answer was 2.20.
        <span class="proof-arrow" aria-hidden="true">→</span> <a href="/projects/rwe-causal" class="proof-inline-link">I can tell when my method is lying</a>.
      </p>
      <p class="proof-context">
        A simulation study — the true effect was sealed until the analysis finished, so the
        estimators could be scored against a known answer. Real data never lets you do that.
      </p>
    </figure>
  </div>

  <dl class="proof-stats reveal" style="--reveal-delay:160ms">
    {stats.map((s) => (
      <div class="proof-stat">
        <dt class="proof-stat-value">{s.value}</dt>
        <dd class="proof-stat-label">{s.label}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .proof {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .proof-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .proof-cards {
      grid-template-columns: 1fr;
    }
  }

  .proof-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .proof-quote {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .proof-lead {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .proof-arrow {
    color: var(--color-accent);
    font-weight: 600;
  }

  .proof-inline-link {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-soft);
    transition: border-color var(--dur) var(--ease);
  }

  .proof-inline-link:hover {
    border-bottom-color: var(--color-accent);
  }

  .proof-attrib {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .proof-context {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Stats strip */
  .proof-stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-8);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-10);
    margin-top: var(--space-4);
  }

  @media (max-width: 900px) {
    .proof-stats {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .proof-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  .proof-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .proof-stat-value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    line-height: 1.1;
  }

  .proof-stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>
