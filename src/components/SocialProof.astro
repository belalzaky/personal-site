---
// §3 — Social proof: grounded in real pharmacovigilance practice.
// Soft attribution only, no names.
import { getCollection } from 'astro:content';

// Single source of truth — derived, never hand-typed.
const projectCount = (await getCollection('projects')).length;

// Each label has to make sense to someone who has never opened a statistics textbook,
// while the value stays precise enough for someone who has. If a label needs a glossary,
// it is the wrong label.
const stats = [
  { value: String(projectCount), label: 'projects built, shipped and public' },
  { value: '46%', label: 'of a real harm the obvious analysis missed' },
  { value: '20M+', label: 'FDA reports of drug side effects analysed' },
  { value: '4 models', label: 'put head to head — the priciest one lost' },
  { value: '26 points', label: 'of accuracy given up, on purpose, to be right' },
];
---

<div class="proof">
  <div class="proof-cards">
    <figure class="proof-card reveal">
      <blockquote class="proof-quote">
        “A litigation flood shows attention; a real safety signal shows a pattern.”
      </blockquote>
      <figcaption class="proof-attrib">— a working pharmacovigilance professional.</figcaption>
      <p class="proof-context">
        Advice from practitioners in the field shaped the direction this whole portfolio follows.
      </p>
    </figure>

    <figure class="proof-card reveal" style="--reveal-delay:80ms">
      <p class="proof-lead">
        I wrote down the right answer, sealed it, and then tried to find it.
        <span class="proof-arrow" aria-hidden="true">→</span> <a href="/projects/rwe-causal" class="proof-inline-link">I can tell when my own method is lying</a>.
      </p>
      <p class="proof-context">
        The patient data was simulated, so the true effect was known in advance and kept hidden
        until the analysis finished. That is the one thing real data can never let you do: mark
        your own work against an answer key.
      </p>
    </figure>
  </div>

  <dl class="proof-stats reveal" style="--reveal-delay:160ms">
    {stats.map((s) => (
      <div class="proof-stat">
        <dt class="proof-stat-value">{s.value}</dt>
        <dd class="proof-stat-label">{s.label}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .proof {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .proof-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .proof-cards {
      grid-template-columns: 1fr;
    }
  }

  .proof-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .proof-quote {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .proof-lead {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .proof-arrow {
    color: var(--color-accent);
    font-weight: 600;
  }

  .proof-inline-link {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-soft);
    transition: border-color var(--dur) var(--ease);
  }

  .proof-inline-link:hover {
    border-bottom-color: var(--color-accent);
  }

  .proof-attrib {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .proof-context {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Stats strip */
  .proof-stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-8);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-10);
    margin-top: var(--space-4);
  }

  @media (max-width: 900px) {
    .proof-stats {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .proof-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  .proof-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .proof-stat-value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    line-height: 1.1;
  }

  .proof-stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>
