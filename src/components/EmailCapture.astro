---
// Email sign-up for new posts. Posts live on Substack, so this links there.

const SUBSTACK = 'https://belalzaky.substack.com';

interface Props {
  heading?: string;
  blurb?: string;
  compact?: boolean;
}

// Defaults are the V2-Writing board's copy.
const {
  heading = 'New posts by email.',
  blurb = 'Get the next write-up when it’s published. No other email.',
  compact = false,
} = Astro.props;
---

<section class:list={['capture', 'card', { 'capture--compact': compact }]}>
  <div class="capture-copy">
    <h2 class="capture-heading">{heading}</h2>
    <p class="capture-blurb">{blurb}</p>
  </div>

  <a class="btn btn-primary capture-link" href={SUBSTACK} target="_blank" rel="noopener noreferrer">
    Subscribe on Substack
  </a>
</section>

<style>
  /* v2: a card with the heading and line on the left, the action on the right */
  .capture {
    padding: 32px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .capture-heading {
    font-size: var(--fs-h2);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .capture-blurb {
    margin-top: 8px;
    font-size: var(--fs-body);
    color: var(--body);
  }



  .capture-link {
    flex: 0 0 auto;
  }

  @media (max-width: 640px) {
    .capture {
      padding: 24px 20px;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
