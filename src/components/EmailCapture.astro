---
// On-site email capture.
//
// ENDPOINT is the only line to change. Left empty, this renders a Substack fallback
// rather than a form that goes nowhere — a dead form is worse than no form.
//
// To own the list rather than Substack's, set ENDPOINT to the form action of whichever
// provider is signed up for (Buttondown, MailerLite, Kit, Listmonk — each gives a POST
// URL taking an `email` field). Nothing else here needs to change.
const ENDPOINT = '';

const SUBSTACK = 'https://belalzaky.substack.com';

interface Props {
  heading?: string;
  blurb?: string;
  compact?: boolean;
}

// Defaults are the V2-Writing board's copy.
const {
  heading = 'New posts by email.',
  blurb = 'Get the next write-up when it’s published. No other email.',
  compact = false,
} = Astro.props;
---

<section class:list={['capture', 'card', { 'capture--compact': compact }]}>
  <div class="capture-copy">
    <h2 class="capture-heading">{heading}</h2>
    <p class="capture-blurb">{blurb}</p>
  </div>

  {ENDPOINT ? (
    <form class="capture-form" action={ENDPOINT} method="post">
      <label class="sr-only" for="capture-email">Email address</label>
      <input
        class="capture-input"
        id="capture-email"
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <button class="btn btn-primary" type="submit">Subscribe</button>
    </form>
  ) : (
    <a class="btn btn-primary capture-link" href={SUBSTACK} target="_blank" rel="noopener noreferrer">
      Subscribe on Substack
    </a>
  )}
</section>

<style>
  /* v2: a card with the heading and line on the left, the action on the right */
  .capture {
    padding: 32px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .capture-heading {
    font-size: var(--fs-h2);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .capture-blurb {
    margin-top: 8px;
    font-size: var(--fs-body);
    color: var(--body);
  }

  .capture-form {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    flex: 0 1 420px;
  }

  .capture-input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 48px;
    font: inherit;
    font-size: 15px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border2);
    border-radius: 999px;
    padding: 0 18px;
  }

  .capture-link {
    flex: 0 0 auto;
  }

  @media (max-width: 640px) {
    .capture {
      padding: 24px 20px;
      flex-direction: column;
      align-items: flex-start;
    }
    .capture-form {
      flex: 1 1 auto;
      width: 100%;
    }
  }
</style>
