---
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow reveal" style="--reveal-delay:0ms">
        DRUG SAFETY · DATA · AI · POLICY
      </p>

      <h1 class="hero-headline reveal" style="--reveal-delay:60ms">
        I turn drug-safety data into things you can <span class="hero-headline-accent">argue with</span>.
      </h1>

      <p class="hero-sub reveal" style="--reveal-delay:120ms">
        Pharmacology, in code and AI — building the tools that separate real
        safety signals from noise, and moving toward the policy decisions built
        on them. In public.
      </p>

      <nav class="hero-actions reveal" style="--reveal-delay:180ms" aria-label="Primary links">
        <a href="/projects" class="btn btn-primary">Explore the work →</a>
        <a href="/writing" class="btn btn-ghost">Read the writing</a>
      </nav>

      <p class="hero-cred reveal" style="--reveal-delay:240ms">
        BSc Pharmacology · King's College London · 6 live data projects · building in public
      </p>
    </div>

    <div class="hero-teaser reveal" style="--reveal-delay:320ms">
      <div class="hero-teaser-head">
        <span class="hero-teaser-live">
          <span class="hero-teaser-dot" aria-hidden="true"></span>LIVE · FAERS SIGNAL DETECTION
        </span>
        <span class="hero-teaser-hint">drag the threshold →</span>
      </div>
      <slot name="interactive" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-16);
      padding-bottom: var(--space-16);
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .hero-copy {
    max-width: 640px;
  }

  /* Eyebrow */
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    max-width: none;
    margin-bottom: var(--space-4);
  }

  /* Headline — Inter 800, ~44px desktop, explicit color so it never inherits wrong */
  .hero-headline {
    font-family: var(--font-sans);
    font-size: var(--text-3xl); /* 2.75rem ≈ 44px */
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .hero-headline-accent {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .hero-headline {
      font-size: var(--text-2xl); /* 2rem ≈ 32px */
    }
  }

  /* Sub */
  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 56ch;
    margin-bottom: var(--space-8);
  }

  /* CTAs */
  .hero-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  /* Credibility strip */
  .hero-cred {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
    max-width: none;
    line-height: 1.7;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  /* Live interactive teaser */
  .hero-teaser {
    width: 100%;
  }

  .hero-teaser-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .hero-teaser-live {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .hero-teaser-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .hero-teaser-hint {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.02em;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: var(--radius);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
    border: 1px solid transparent;
    white-space: nowrap;
    line-height: 1;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #ffffff;
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
