---
import km from "../../data/km-curves.json";
---
<div class="sc js-survival-curves" role="group" aria-label="Interactive Kaplan-Meier survival curves">
  <p class="sc-sr">Toggle to split the survival curve by diabetes status; diabetic patients develop hypertension faster.</p>
  <div class="sc-eyebrow">EHR SURVIVAL · KAPLAN–MEIER</div>
  <h3 class="sc-title">How long until hypertension?</h3>
  <p class="sc-sub">The curve is the share of patients still hypertension-free as years pass — it only ever steps down, once per diagnosis. Split it by diabetes.</p>

  <div class="sc-toggle" role="tablist">
    <button class="sc-btn" data-m="all" role="tab">All patients</button>
    <button class="sc-btn active" data-m="diab" role="tab">By diabetes status</button>
  </div>

  <div class="sc-legend"></div>
  <div class="sc-chartwrap"><svg class="sc-svg" viewBox="0 0 640 320" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Survival curves"></svg></div>

  <div class="sc-verdict"><span class="sc-text"></span></div>
  <p class="sc-foot">A patient still event-free just means we hadn't seen it happen yet — censored, not deleted. That's most of this cohort.</p>

  <script type="application/json" class="sc-data" set:html={JSON.stringify(km)}></script>
</div>

<style>
  .sc{ --slate:#7c8598; font-family:var(--font-sans); color:var(--color-text); background:var(--color-surface);
    border:1px solid var(--color-border); border-radius:var(--radius,12px); padding:26px 28px 22px; max-width:720px; box-sizing:border-box; }
  :global([data-theme="dark"]) .sc{ --slate:#8a92a0; }
  .sc *{ box-sizing:border-box; }
  .sc-sr{ position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0); }
  .sc-eyebrow{ font-family:var(--font-mono); font-size:11px; letter-spacing:.14em; color:var(--color-accent); margin-bottom:8px; }
  .sc-title{ font-size:23px; font-weight:700; letter-spacing:-.02em; margin:0 0 6px; }
  .sc-sub{ font-size:13.5px; line-height:1.6; color:var(--color-text-muted); margin:0 0 16px; max-width:60ch; }
  .sc-toggle{ display:inline-flex; flex-wrap:wrap; border:1px solid var(--color-border); border-radius:9px; padding:4px; margin-bottom:16px; background:var(--color-bg); gap:4px; }
  .sc-btn{ font-family:var(--font-mono); font-size:12px; font-weight:600; padding:8px 14px; border:0; background:transparent; color:var(--color-text-muted); border-radius:6px; cursor:pointer; transition:all .18s; }
  .sc-btn:hover{ color:var(--color-text); }
  .sc-btn.active{ background:var(--color-accent); color:#fff; }
  .sc-legend{ display:flex; gap:20px; margin-bottom:6px; min-height:20px; font-size:13px; font-weight:500; color:var(--color-text); }
  .sc-lg{ display:flex; align-items:center; gap:7px; }
  .sc-sw{ width:16px; height:4px; border-radius:2px; display:inline-block; }
  .sc-chartwrap{ width:100%; margin-bottom:14px; }
  .sc-svg{ width:100%; height:auto; display:block; overflow:visible; }
  :global(.sc-grid){ stroke:var(--color-border); stroke-width:1; }
  :global(.sc-med){ stroke:var(--color-border); stroke-width:1.25; stroke-dasharray:5 4; }
  :global(.sc-ylab),:global(.sc-xlab){ font-family:var(--font-mono); font-size:13px; fill:var(--color-text-muted); }
  :global(.sc-axtitle){ font-family:var(--font-sans); font-size:12px; fill:var(--color-text-subtle); text-anchor:middle; }
  :global(.sc-medlab){ font-family:var(--font-mono); font-size:11px; fill:var(--color-text-subtle); text-anchor:end; }
  :global(.sc-endlab){ font-family:var(--font-mono); font-size:13px; font-weight:600; }
  .sc-verdict{ padding:12px 15px; border-radius:8px; background:var(--color-bg); border:1px solid var(--color-border); border-left:3px solid var(--color-accent); font-size:13px; line-height:1.55; color:var(--color-text-muted); margin-bottom:12px; }
  .sc-verdict b{ color:var(--color-text); }
  .sc-foot{ font-size:12.5px; color:var(--color-text-subtle); margin:0; font-style:italic; }
</style>

<script is:inline>
  (function(){
    const NS="http://www.w3.org/2000/svg";
    function init(root){
      if(root.dataset.init) return; root.dataset.init="1";
      const data=JSON.parse(root.querySelector('.sc-data').textContent);
      const accent=getComputedStyle(root).getPropertyValue('--color-accent').trim()||'#2546f0';
      const slate=getComputedStyle(root).getPropertyValue('--slate').trim()||'#7c8598';
      const svg=root.querySelector('.sc-svg');
      const legend=root.querySelector('.sc-legend');
      const verdict=root.querySelector('.sc-text');
      const L=56,R=560,T=22,B=262;
      const series=[data.overall,data.diabetic,data.nondiabetic];
      const xMax=Math.ceil(Math.max(...series.map(s=>s[s.length-1][0])));
      const x=t=>L+t/xMax*(R-L);
      const y=p=>B-p*(B-T);
      const el=(t,a)=>{const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);return e;};
      [0,0.25,0.5,0.75,1].forEach(p=>{svg.appendChild(el('line',{class:'sc-grid',x1:L,y1:y(p),x2:R,y2:y(p)}));const t=el('text',{class:'sc-ylab',x:L-9,y:y(p)+4,'text-anchor':'end'});t.textContent=(p*100)+'%';svg.appendChild(t);});
      svg.appendChild(el('line',{class:'sc-med',x1:L,y1:y(0.5),x2:R,y2:y(0.5)}));
      const ml=el('text',{class:'sc-medlab',x:R,y:y(0.5)-5});ml.textContent='median (50%)';svg.appendChild(ml);
      const step=Math.max(1,Math.ceil(xMax/6));
      for(let t=0;t<=xMax;t+=step){const tx=el('text',{class:'sc-xlab',x:x(t),y:B+20,'text-anchor':'middle'});tx.textContent=t;svg.appendChild(tx);}
      const at=el('text',{class:'sc-axtitle',x:(L+R)/2,y:B+40});at.textContent='years of follow-up';svg.appendChild(at);
      function stepD(pts){let d='M'+x(pts[0][0]).toFixed(1)+' '+y(pts[0][1]).toFixed(1);for(let i=1;i<pts.length;i++){d+=' L'+x(pts[i][0]).toFixed(1)+' '+y(pts[i-1][1]).toFixed(1)+' L'+x(pts[i][0]).toFixed(1)+' '+y(pts[i][1]).toFixed(1);}return d;}
      const pA=el('path',{fill:'none','stroke-width':2.75,'stroke-linejoin':'round','stroke-linecap':'round'});
      const pB=el('path',{fill:'none','stroke-width':2.75,'stroke-linejoin':'round','stroke-linecap':'round'});
      svg.appendChild(pA);svg.appendChild(pB);
      const endWrap=el('g',{});svg.appendChild(endWrap);
      const reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function anim(path,pts,color){path.setAttribute('stroke',color);path.setAttribute('d',stepD(pts));if(reduce)return;const len=path.getTotalLength();path.style.transition='none';path.style.strokeDasharray=len;path.style.strokeDashoffset=len;path.getBoundingClientRect();path.style.transition='stroke-dashoffset 1.1s ease';path.style.strokeDashoffset=0;}
      function endLabel(pts,color){const last=pts[pts.length-1];const t=el('text',{class:'sc-endlab',x:x(last[0])+8,y:y(last[1])+4,fill:color});t.textContent=Math.round(last[1]*100)+'%';t.style.opacity=0;t.style.transition='opacity .4s ease 1s';endWrap.appendChild(t);requestAnimationFrame(()=>t.style.opacity=1);}
      const p=data.logrank_p, pTxt = p<0.001 ? 'p &lt; 0.001' : 'p = '+p.toFixed(3);
      function draw(mode){
        legend.innerHTML='';endWrap.innerHTML='';
        if(mode==='all'){
          anim(pA,data.overall,accent);pB.setAttribute('d','');endLabel(data.overall,accent);
          verdict.innerHTML='Across everyone, most patients stay hypertension-free through follow-up — the curve never falls near the 50% line, so there is <b>no median time-to-event</b>. The event just doesn’t reach most people in the window.';
        } else {
          anim(pA,data.nondiabetic,slate);anim(pB,data.diabetic,accent);endLabel(data.nondiabetic,slate);endLabel(data.diabetic,accent);
          legend.innerHTML='<span class="sc-lg"><span class="sc-sw" style="background:'+accent+'"></span>Diabetic</span><span class="sc-lg"><span class="sc-sw" style="background:'+slate+'"></span>Non-diabetic</span>';
          verdict.innerHTML='<b>Diabetic patients develop hypertension markedly faster</b> — their curve pulls away from the non-diabetic one almost immediately (log-rank '+pTxt+'). The non-diabetic curve stays high and never reaches 50%.';
        }
      }
      root.querySelectorAll('.sc-btn').forEach(b=>b.addEventListener('click',()=>{
        root.querySelectorAll('.sc-btn').forEach(z=>z.classList.remove('active'));
        b.classList.add('active');draw(b.dataset.m);
      }));
      if(reduce){draw('diab');}
      else{const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){draw('diab');io.disconnect();}}),{threshold:.25});io.observe(root);}
    }
    function boot(){document.querySelectorAll('.js-survival-curves').forEach(init);}
    if(document.readyState!=='loading')boot();else document.addEventListener('DOMContentLoaded',boot);
  })();
</script>
