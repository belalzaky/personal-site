---
import data from "../../data/synthea-cohorts.json";
const cohorts = data.cohorts;
---
<div class="syc js-synthea-cohorts" role="group" aria-label="Interactive cohort treatment explorer">
  <p class="syc-sr">Pick a condition to see the top prescribed medications for that cohort of synthetic patients.</p>
  <div class="syc-eyebrow">SYNTHEA · EHR COHORTS</div>
  <h3 class="syc-title">Define a group. Look at their treatment.</h3>
  <p class="syc-sub">Pick a condition and see what its patients were actually prescribed — the top 5 drugs, by how many of the cohort received each.</p>

  <div class="syc-toggle" role="tablist">
    {cohorts.map((c, i) => (
      <button class={"syc-btn" + (i === 0 ? " active" : "")} data-i={i} role="tab">{c.label}</button>
    ))}
  </div>

  <div class="syc-cohort">Cohort: <b class="syc-size">–</b> patients · top prescribed medications</div>
  <div class="syc-rows"></div>

  <div class="syc-note"><span class="syc-mark">!</span><span>The most-prescribed drug is often a common background medicine — for the hypertension cohort it's acetaminophen, not one of the first-line blood-pressure drugs — so you have to know which class matters. And this is synthetic data: any drug–disease link is <b>designed in, not discovered</b>.</span></div>

  <script type="application/json" class="syc-data" set:html={JSON.stringify(cohorts)}></script>
</div>

<style>
  .syc{ font-family:var(--font-sans); color:var(--color-text); background:var(--color-surface);
    border:1px solid var(--color-border); border-radius:var(--radius,12px); padding:26px 28px 22px; max-width:720px; box-sizing:border-box; }
  .syc *{ box-sizing:border-box; }
  .syc-sr{ position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0); }
  .syc-eyebrow{ font-family:var(--font-mono); font-size:11px; letter-spacing:.14em; color:var(--color-accent); margin-bottom:8px; }
  .syc-title{ font-size:23px; font-weight:700; letter-spacing:-.02em; margin:0 0 6px; }
  .syc-sub{ font-size:13.5px; line-height:1.6; color:var(--color-text-muted); margin:0 0 18px; max-width:58ch; }
  .syc-toggle{ display:inline-flex; flex-wrap:wrap; border:1px solid var(--color-border); border-radius:9px; padding:4px; margin-bottom:18px; background:var(--color-bg); gap:4px; }
  .syc-btn{ font-family:var(--font-mono); font-size:12px; font-weight:600; padding:8px 14px; border:0; background:transparent; color:var(--color-text-muted); border-radius:6px; cursor:pointer; transition:all .18s; }
  .syc-btn:hover{ color:var(--color-text); }
  .syc-btn.active{ background:var(--color-accent); color:#fff; }
  .syc-cohort{ font-size:12.5px; color:var(--color-text-muted); margin-bottom:14px; }
  .syc-cohort b{ color:var(--color-text); font-family:var(--font-mono); }
  .syc-rows{ margin-bottom:18px; }
  .syc-note{ display:flex; gap:10px; align-items:flex-start; padding:12px 14px; border-radius:8px; background:var(--color-bg); font-size:12.5px; line-height:1.55; color:var(--color-text-muted); }
  .syc-note b{ color:var(--color-text); }
  .syc-mark{ font-family:var(--font-mono); font-weight:700; color:#c0492f; width:14px; flex:none; text-align:center; }
  :global([data-theme="dark"]) .syc-mark{ color:#dd7a63; }
</style>

<script is:inline>
  (function(){
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function init(root){
      if(root.dataset.init) return; root.dataset.init="1";
      function clean(s){ return s
        .replace(/\b24 HR\b/gi,'').replace(/Extended Release/gi,'ER')
        .replace(/ Oral (Tablet|Capsule)/gi,'')
        .replace(/\b(hydrochloride|medoxomil|besylate|mesylate|potassium|sodium)\b/gi,'')
        .replace(/\s+/g,' ').trim(); }
      const cohorts = JSON.parse(root.querySelector('.syc-data').textContent);
      const rowsWrap = root.querySelector('.syc-rows');
      const n = Math.max(...cohorts.map(c=>c.meds.length));
      const rows = [];
      for(let i=0;i<n;i++){
        const row=document.createElement('div'); row.style.cssText='display:flex;align-items:center;min-height:40px;gap:14px;padding:6px 0;';
        const lab=document.createElement('div'); lab.style.cssText='width:240px;flex:none;text-align:right;font-size:12px;font-weight:500;line-height:1.3;color:var(--color-text);';
        const track=document.createElement('div'); track.style.cssText='flex:1;position:relative;height:22px;';
        const fill=document.createElement('div'); fill.style.cssText='position:absolute;left:0;top:0;height:100%;width:0;background:var(--color-accent);border-radius:4px;transition:width .7s cubic-bezier(.2,.7,.2,1);display:flex;align-items:center;justify-content:flex-end;';
        const count=document.createElement('span'); count.style.cssText='font-family:var(--font-mono);font-size:11px;font-weight:600;color:#fff;padding-right:8px;opacity:0;transition:opacity .4s ease .35s;';
        fill.appendChild(count); track.appendChild(fill); row.appendChild(lab); row.appendChild(track); rowsWrap.appendChild(row);
        rows.push({row,lab,fill,count});
      }
      function draw(idx){
        const c=cohorts[idx]; const max=Math.max(...c.meds.map(m=>m[1]));
        root.querySelector('.syc-size').textContent=c.size;
        rows.forEach((r,i)=>{
          const m=c.meds[i];
          if(!m){ r.row.style.display='none'; return; }
          r.row.style.display='flex';
          r.lab.textContent=clean(m[0]); r.count.textContent=m[1];
          r.fill.style.width='0'; r.count.style.opacity='0';
          const w=(m[1]/max*100)+'%';
          if(reduce){ r.fill.style.transition='none'; r.fill.style.width=w; r.count.style.opacity='1'; }
          else requestAnimationFrame(()=>{ r.fill.style.width=w; r.count.style.opacity='1'; });
        });
      }
      root.querySelectorAll('.syc-btn').forEach(b=>b.addEventListener('click',()=>{
        root.querySelectorAll('.syc-btn').forEach(x=>x.classList.remove('active'));
        b.classList.add('active'); draw(parseInt(b.dataset.i,10));
      }));
      if(reduce){ draw(0); }
      else { const io=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ draw(0); io.disconnect(); } }),{threshold:.25}); io.observe(root); }
    }
    function boot(){ document.querySelectorAll('.js-synthea-cohorts').forEach(init); }
    if(document.readyState!=='loading') boot(); else document.addEventListener('DOMContentLoaded', boot);
  })();
</script>
