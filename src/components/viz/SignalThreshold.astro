---
// Real Lap 4 negative-control panel — sorted descending by PRR
const PAIRS = [
  { label: "Simvastatin → Rhabdomyolysis", prr: 11.0 },
  { label: "Methotrexate → Pancytopenia",  prr:  6.1 },
  { label: "Warfarin → Haemorrhage",       prr:  5.0 },
  { label: "Lisinopril → Rhabdomyolysis",  prr:  1.61 },
  { label: "Metformin → Haemorrhage",      prr:  1.31 },
];
const AXIS_MAX = 12;
const DEFAULT_THRESHOLD = 2;

const initOn  = PAIRS.filter(p => p.prr >= DEFAULT_THRESHOLD).length;
const initOff = PAIRS.length - initOn;

// Unique per-instance id so multiple embeds (e.g. hero + featured card)
// don't produce duplicate DOM ids / broken label association.
const sliderId = `st-slider-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="st" data-viz="signal-threshold">

  <!-- ── Header ──────────────────────────────────────────────────── -->
  <div class="st-header">
    <p class="st-eyebrow">FAERS · DISPROPORTIONALITY</p>
    <h2 class="st-title">Where's the line between signal and noise?</h2>
    <p class="st-caption">
      Each bar is a drug–reaction pair's PRR — how much more often that reaction
      is reported with the drug than with everything else. Drag the threshold;
      watch which pairs stay signals.
    </p>
  </div>

  <!-- ── Live readout ────────────────────────────────────────────── -->
  <div class="st-readout" aria-live="polite" aria-atomic="true">
    <span class="st-readout-label">
      Threshold PRR ≥ <strong class="js-thresh-val">{DEFAULT_THRESHOLD.toFixed(1)}</strong>
    </span>
    <span class="st-pill st-pill--on">
      <span class="js-count-on">{initOn}</span> signals
    </span>
    <span class="st-pill st-pill--off">
      <span class="js-count-off">{initOff}</span> non-signals
    </span>
  </div>

  <!-- ── Chart ───────────────────────────────────────────────────── -->
  <div class="st-chart">

    <!-- Label column -->
    <div class="st-labels" aria-hidden="true">
      {PAIRS.map(p => (
        <div class="st-label">{p.label}</div>
      ))}
    </div>

    <!-- Track column: bars + threshold line share same coordinate space -->
    <div class="st-tracks">
      {PAIRS.map((p, i) => (
        <div class="st-track">
          <div
            class="st-bar"
            data-prr={p.prr}
            data-signal={p.prr >= DEFAULT_THRESHOLD ? "1" : "0"}
            style={`--target-w:${(p.prr / AXIS_MAX * 100).toFixed(3)}%;--delay:${i * 110}ms`}
          >
            <span class={`st-bar-val ${p.prr >= 2.5 ? "st-bar-val--in" : "st-bar-val--out"}`}>
              {p.prr}
            </span>
          </div>
        </div>
      ))}

      <!-- Dashed threshold line spanning all tracks -->
      <div
        class="st-thresh-line"
        aria-hidden="true"
        style={`left:${(DEFAULT_THRESHOLD / AXIS_MAX * 100).toFixed(3)}%`}
      >
        <span class="st-thresh-tag js-line-tag">PRR {DEFAULT_THRESHOLD.toFixed(1)}</span>
      </div>
    </div>

  </div>

  <!-- ── Slider ──────────────────────────────────────────────────── -->
  <div class="st-footer">
    <label class="st-slider-label" for={sliderId}>Signal threshold</label>
    <input
      class="st-slider"
      id={sliderId}
      type="range"
      min="1"
      max="6"
      step="0.1"
      value={DEFAULT_THRESHOLD}
    />
  </div>

</figure>

<style>
  /* ── Local vars (light / dark) ─────────────────────────────────── */
  .st {
    --bar-off: #d3d6de;
  }
  :global([data-theme="dark"]) .st {
    --bar-off: #3a3a3d;
  }

  /* ── Wrapper ────────────────────────────────────────────────────── */
  .st {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-8);
    font-family: var(--font-sans);
    overflow: hidden;
  }

  /* ── Header ─────────────────────────────────────────────────────── */
  .st-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
    max-width: none;
  }

  .st-title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .st-caption {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 62ch;
  }

  /* ── Readout ────────────────────────────────────────────────────── */
  .st-readout {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .st-readout-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .st-readout-label strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .st-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 2px 10px;
    border-radius: 999px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .st-pill--on {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .st-pill--off {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* ── Chart layout ───────────────────────────────────────────────── */
  .st-chart {
    display: flex;
    gap: var(--space-4);
  }

  /* Label column — shrinks on narrow screens */
  .st-labels {
    display: flex;
    flex-direction: column;
    width: 210px;
    flex-shrink: 1;
    min-width: 0;
  }

  .st-label {
    height: 40px;
    display: flex;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-right: var(--space-2);
  }

  /* Track column */
  .st-tracks {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .st-track {
    height: 40px;
    display: flex;
    align-items: center;
  }

  /* ── Bars ───────────────────────────────────────────────────────── */
  .st-bar {
    position: relative;
    height: 26px;
    width: 0;                          /* entrance starts at 0 */
    border-radius: 3px;
    background-color: var(--color-accent);
    /* width animates on .st[data-ready]; background transitions on threshold change */
    transition:
      width 0.65s var(--ease) var(--delay),
      background-color 0.3s ease;
    will-change: width;
  }

  /* IO fires → data-ready → bars expand */
  .st[data-ready] .st-bar {
    width: var(--target-w);
  }

  /* Signal coloring driven by data attribute — CSS vars resolve at paint,
     so dark-mode accent / bar-off update automatically on theme toggle */
  .st-bar[data-signal="1"] { background-color: var(--color-accent); }
  .st-bar[data-signal="0"] { background-color: var(--bar-off); }

  /* ── Bar value labels ───────────────────────────────────────────── */
  .st-bar-val {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    /* Hidden until the bars expand (data-ready). At width:0 the right-anchored
       value would otherwise overflow left onto the label column — most visible
       in the narrow featured-card embed. Fades in once bars have grown, where
       there is always clear separation from the labels. */
    opacity: 0;
    transition: color 0.3s ease, opacity 0.35s ease 0.4s;
  }

  .st[data-ready] .st-bar-val {
    opacity: 1;
  }

  /* Inside: right-aligned within the bar */
  .st-bar-val--in {
    right: 7px;
  }
  .st-bar[data-signal="1"] .st-bar-val--in { color: #ffffff; }
  .st-bar[data-signal="0"] .st-bar-val--in { color: var(--color-text); }

  /* Outside: to the right of the bar, always muted */
  .st-bar-val--out {
    left: calc(100% + 7px);
    color: var(--color-text-muted);
  }

  /* ── Threshold line ─────────────────────────────────────────────── */
  .st-thresh-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1.5px dashed var(--color-text-subtle);
    transition: left 0.25s ease;
    pointer-events: none;
    z-index: 2;
  }

  .st-thresh-tag {
    position: absolute;
    top: -22px;
    left: 5px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-subtle);
    white-space: nowrap;
    background: var(--color-surface);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
  }

  /* ── Slider ─────────────────────────────────────────────────────── */
  .st-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .st-slider-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
    cursor: default;
  }

  .st-slider {
    flex: 1;
    min-width: 0;
    accent-color: var(--color-accent);
    cursor: pointer;
    height: 4px;
  }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 560px) {
    .st {
      padding: var(--space-6);
    }
    .st-labels {
      width: 120px;
    }
    .st-label {
      font-size: var(--text-xs);
    }
    .st-title {
      font-size: var(--text-lg);
    }
  }
</style>

<script>
  const AXIS_MAX = 12;

  function initViz(fig: HTMLElement) {
    const bars      = Array.from(fig.querySelectorAll<HTMLElement>('.st-bar'));
    const line      = fig.querySelector<HTMLElement>('.st-thresh-line')!;
    const lineTag   = fig.querySelector<HTMLElement>('.js-line-tag')!;
    const slider    = fig.querySelector<HTMLInputElement>('.st-slider')!;
    const threshVal = fig.querySelector<HTMLElement>('.js-thresh-val')!;
    const countOn   = fig.querySelector<HTMLElement>('.js-count-on')!;
    const countOff  = fig.querySelector<HTMLElement>('.js-count-off')!;

    // Apply a threshold value: update line position, bar colours, readout
    function applyThreshold(t: number) {
      const pct = (t / AXIS_MAX) * 100;
      line.style.left        = `${pct}%`;
      lineTag.textContent    = `PRR ${t.toFixed(1)}`;
      threshVal.textContent  = t.toFixed(1);

      let on = 0, off = 0;
      bars.forEach(bar => {
        const prr      = parseFloat(bar.dataset.prr ?? '0');
        const isSignal = prr >= t;
        bar.dataset.signal = isSignal ? '1' : '0';
        if (isSignal) on++; else off++;
      });
      countOn.textContent  = String(on);
      countOff.textContent = String(off);
    }

    // Entrance: add data-ready to trigger CSS width transition on each bar.
    // global.css already sets transition-duration: 0.01ms under
    // prefers-reduced-motion, so no explicit branch is needed — bars
    // jump to final width instantly in that mode.
    const io = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        fig.dataset.ready = '';
        io.disconnect();
      }
    }, { threshold: 0.15 });
    io.observe(fig);

    // Slider
    slider.addEventListener('input', () => {
      applyThreshold(parseFloat(slider.value));
    });

    // Set initial colours (bars start at width 0 via CSS, colours set here)
    applyThreshold(parseFloat(slider.value));
  }

  // Boot every instance on the page
  document.querySelectorAll<HTMLElement>('[data-viz="signal-threshold"]').forEach(initViz);
</script>
