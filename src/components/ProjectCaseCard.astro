---
/* Same four layers as FeaturedWorkCard — see src/data/project-cases.ts.
 * The stake carries the card; the title is demoted to a label above it, because a project
 * name tells a visitor nothing and the stake tells them everything. */
interface Props {
  title: string;
  stake: string;
  finding: string;
  method: string;
  decision: string;
  tags: string[];
  href: string;
  github?: string;
  link?: string;
  delay?: number;
}

const { title, stake, finding, method, decision, tags, href, github, link, delay = 0 } = Astro.props;
---

<article class="pcard reveal" style={`--reveal-delay:${delay}ms`}>
  <div class="pcard-top">
    <span class="pcard-badge">◆ INTERACTIVE</span>
    <ul class="pcard-tags" role="list" aria-label="Stack">
      {tags.map((t) => <li class="tag" role="listitem">{t}</li>)}
    </ul>
  </div>

  <p class="pcard-project">{title}</p>

  <h3 class="pcard-title">
    <a href={href} class="pcard-link">{stake}</a>
  </h3>

  <div class="pcard-case">
    <p class="pcard-found">{finding}</p>
    <p class="pcard-method">{method}</p>
    <p class="pcard-decision">
      <span class="pcard-k pcard-k--decision">So what</span>{decision}
    </p>
  </div>

  <div class="pcard-footer">
    <a href={href} class="pcard-cta" aria-label={`Read more about ${title}`}>
      View project <span aria-hidden="true">→</span>
    </a>
    <div class="pcard-ext">
      {link && (
        <a href={link} class="pcard-ext-link" target="_blank" rel="noopener noreferrer">Live ↗</a>
      )}
      {github && (
        <a href={github} class="pcard-ext-link" target="_blank" rel="noopener noreferrer">GitHub</a>
      )}
    </div>
  </div>
</article>

<style>
  .pcard {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .pcard:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px -6px rgba(0, 0, 0, 0.1);
  }

  :global([data-theme="dark"]) .pcard:hover {
    box-shadow: 0 8px 28px -6px rgba(0, 0, 0, 0.45);
  }

  /* Top row: badge + stack pills */
  .pcard-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pcard-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    white-space: nowrap;
  }

  .pcard-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-left: auto;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    font-weight: 500;
  }

  /* Title */
  /* The project name, demoted to a label. It identifies the work; it does not sell it. */
  .pcard-project {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    max-width: none;
  }

  .pcard-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .pcard-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .pcard-link:hover {
    color: var(--color-accent);
  }

  /* Case-study framing: Problem → What I found */
  .pcard-case {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .pcard-k {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: 3px;
  }

  .pcard-k--decision {
    color: var(--color-accent);
  }

  /* Layer 2 — the number. */
  .pcard-found {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    max-width: none;
  }

  /* Layer 3 — secondary by design. Scannable, never in the way. */
  .pcard-method {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    line-height: 1.65;
    max-width: none;
  }

  /* Layer 4 — the judgement. */
  .pcard-decision {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: 500;
    line-height: 1.55;
    max-width: none;
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-3);
  }

  /* Footer */
  .pcard-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .pcard-cta {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .pcard-cta:hover {
    color: var(--color-accent-hover);
  }

  .pcard-ext {
    display: flex;
    gap: var(--space-3);
  }

  .pcard-ext-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .pcard-ext-link:hover {
    color: var(--color-text);
  }
</style>
