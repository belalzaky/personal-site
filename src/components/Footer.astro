---
// v2 footer: name and place, socials only.
const year = new Date().getFullYear();

const socials = [
  { href: 'https://linkedin.com/in/belalzaky', label: 'LinkedIn' },
  { href: 'https://instagram.com/belalzakyuk', label: 'Instagram' },
  { href: 'https://github.com/belalzaky', label: 'GitHub' },
  { href: 'https://belalzaky.substack.com', label: 'Substack' },
];
---

<footer class="footer wrap">
  <div class="footer-inner">
    <span>© {year} Belal Zaky · London | Dubai</span>
    <nav class="footer-links" aria-label="Social links">
      {socials.map(({ href, label }) => (
        <a href={href} class="footer-link" target="_blank" rel="noopener noreferrer">{label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: 48px;
  }

  .footer-inner {
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-size: 14px;
    color: var(--label);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-link {
    color: var(--label);
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--text);
  }
</style>
