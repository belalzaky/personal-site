---
// The nav row: seven cells. The current page inverts. The last cell switches light and dark.
// On a phone it folds to one row that stays at the top: the name, and a menu that opens
// the links full-screen with the mode switch at the bottom.
interface Props { current?: string }
const { current } = Astro.props;
const links = [
  { key: 'index', href: '/', label: 'belal zaky', cls: 'me' },
  { key: 'work', href: '/projects', label: 'work' },
  { key: 'builds', href: '/builds', label: 'builds' },
  { key: 'about', href: '/about', label: 'about' },
  { key: 'camera-roll', href: '/camera-roll', label: 'camera roll' },
  { key: 'cv', href: '/cv', label: 'cv' },
];
---

<nav class="navrow" aria-label="Main">
  {links.map((l) => (
    <a href={l.href} class={l.cls} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
  ))}
  <button type="button" class="mode" data-mode aria-label="Switch between light and dark"><span>mode</span><b data-mode-v>(light)</b></button>
  <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu">menu</button>
</nav>
<div class="menu" id="menu" hidden>
  {links.slice(1).map((l) => (
    <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.key === 'cv' ? 'CV' : l.label[0].toUpperCase() + l.label.slice(1)}<span class="lbl">{l.href}</span></a>
  ))}
  <button type="button" class="mode2" data-mode aria-label="Switch between light and dark"><span>mode</span><b data-mode-v>(light)</b></button>
</div>
