---
// v2 nav: brand, four links and an "Email me" pill. The current page is underlined.
// On phones the links sit on a second row, always visible. No hamburger, no toggle.
const navLinks = [
  { href: '/projects', label: 'Work' },
  { href: '/mission-control', label: 'Mission Control' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="nav wrap">
  <div class="nav-top">
    <a href="/" class="nav-brand"><span class="nav-mark" aria-hidden="true">BZ</span>Belal Zaky</a>
    <div class="nav-right">
      <nav aria-label="Main" class="nav-links nav-links--desk">
        {navLinks.map(({ href, label }) => (
          <a href={href} class="nav-link" aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a href="mailto:hello@belalzaky.uk" class="nav-pill">Email me</a>
    </div>
  </div>
  <nav aria-label="Main" class="nav-links nav-links--mob">
    {navLinks.map(({ href, label }) => (
      <a href={href} class="nav-link" aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>

<style>
  .nav {
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    white-space: nowrap;
  }

  .nav-mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--text);
    color: var(--bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-links {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    color: var(--body);
    text-decoration: none;
    font-size: 15px;
    white-space: nowrap;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link[aria-current='page'] {
    color: var(--text);
    text-decoration-line: underline;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--border2);
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .nav-links--mob {
    display: none;
  }

  @media (max-width: 760px) {
    .nav {
      padding-top: 16px;
      padding-bottom: 0;
    }
    .nav-links--desk { display: none; }
    .nav-links--mob {
      display: flex;
      gap: 20px;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
    }
  }
</style>
