---
// The nav row: six cells. The current page inverts. The last cell switches light and dark.
interface Props { current?: string }
const { current } = Astro.props;
const links = [
  { key: 'index', href: '/', label: 'belal zaky', cls: 'me' },
  { key: 'work', href: '/projects', label: 'work' },
  { key: 'builds', href: '/builds', label: 'builds' },
  { key: 'about', href: '/about', label: 'about' },
  { key: 'cv', href: '/cv', label: 'cv' },
];
---

<nav class="navrow" aria-label="Main">
  {links.map((l) => (
    <a href={l.href} class={l.cls} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
  ))}
  <button type="button" class="mode" id="mode" aria-label="Switch between light and dark"><span>mode</span><b id="mode-v">(light)</b></button>
</nav>
